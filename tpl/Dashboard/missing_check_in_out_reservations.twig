<div class="dashboard upcomingReservationsDashboard accordion-item shadow mb-2" id="upcomingReservationsDashboard">
    <div class="accordion-header dashboardHeader">
        <button class="accordion-button collapsed link-primary fw-bold" type="button" data-bs-toggle="collapse"
            data-bs-target="#MissingCheckOutReservationsContents" aria-expanded="false"
            aria-controls="MissingCheckOutReservationsContents">{{ translate('MissingCheckOutReservations') }}<span
                class="badge bg-primary ms-1">{{ Total }}</span>
        </button>
    </div>
    <div id="MissingCheckOutReservationsContents" class="accordion-collapse collapse">
        <div class="dashboardContents accordion-body">
            {% if Total > 0 %}
                <div>
                    <div class="timespan bg-warning border-bottom p-1 fw-medium fst-italic">
                        {{ translate('Today') }} ({{ (TodaysReservations ?? [])|length }})
                    </div>
                    {% for reservation in TodaysReservations %}
                        {{ include('Dashboard/dashboard_reservation.twig', {reservation: reservation, allowCheckin: allowCheckin, allowCheckout: allowCheckout}) }}
                    {% endfor %}

                    <div class="timespan bg-warning border-bottom p-1 fw-medium fst-italic">
                        {{ translate('Yesterday') }} ({{ (YesterdayReservations ?? [])|length }})
                    </div>
                    {% for reservation in YesterdayReservations %}
                        {{ include('Dashboard/dashboard_reservation.twig', {reservation: reservation, allowCheckin: allowCheckin, allowCheckout: allowCheckout}) }}
                    {% endfor %}

                    <div class="timespan bg-warning border-bottom p-1 fw-medium fst-italic">
                        {{ translate('EarlierThisWeek') }} ({{ (ThisWeeksReservations ?? [])|length }})
                    </div>
                    {% for reservation in ThisWeeksReservations %}
                        {{ include('Dashboard/dashboard_reservation.twig', {reservation: reservation, allowCheckin: allowCheckin, allowCheckout: allowCheckout}) }}
                    {% endfor %}

                    <div class="timespan bg-warning border-bottom p-1 fw-medium fst-italic">
                        {{ translate('PreviousWeek') }} ({{ (PreviousWeekReservations ?? [])|length }})
                    </div>
                    {% for reservation in PreviousWeekReservations %}
                        {{ include('Dashboard/dashboard_reservation.twig', {reservation: reservation, allowCheckin: allowCheckin, allowCheckout: allowCheckout}) }}
                    {% endfor %}

                    <div class="timespan bg-warning border-bottom p-1 fw-medium fst-italic">
                        {{ translate('Other') }} ({{ (RemainingReservations ?? [])|length }})
                    </div>
                    {% for reservation in RemainingReservations %}
                        {{ include('Dashboard/dashboard_reservation.twig', {reservation: reservation, allowCheckin: allowCheckin, allowCheckout: allowCheckout}) }}
                    {% endfor %}
                </div>
            {% else %}
                <div class="noresults text-center fst-italic fs-5">{{ translate('NoMissingCheckOutReservations') }}</div>
            {% endif %}
        </div>
    </div>

    <form id="form-checkin" method="post">
        <input type="hidden" id="referenceNumber" {{ formname('REFERENCE_NUMBER') }} />
        {{ csrf_token() }}
    </form>

    {# <form id="form-checkout" method="post" action="ajax/reservation_checkin.php?action={{ constant('ReservationAction::Checkout') }}"> #}
    {# <input type="hidden" id="referenceNumber" {{ formname('REFERENCE_NUMBER') }} /> #}
    {# {{ csrf_token() }} #}
    {# </form> #}
</div>
