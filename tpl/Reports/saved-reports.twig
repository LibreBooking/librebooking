{{ include('globalheader.twig', {DataTable: true}) }}
{% set tableId = '' %}

<div id="page-saved-reports" class="accordion">
    <div>
        <div class="accordion-item shadow mb-2" id="saved-reports-panel">
            <h2 class="accordion-header">
                <button class="accordion-button link-primary fw-bold" type="button" data-bs-toggle="collapse"
                    data-bs-target="#panelReportSaved" aria-expanded="false" aria-controls="panelReportSaved">
                    {{ translate('MySavedReports') }} <span
                        class="badge bg-primary ms-1">{{ (ReportList is defined and ReportList ? ReportList|length : 0) }}</span>
                </button>
            </h2>
            <div id="panelReportSaved" class="accordion-collapse collapse">
                <div class="accordion-body no-padding">
                    {% if (ReportList is defined and ReportList ? ReportList|length : 0) == 0 %}
                        <h3 class="no-data text-center">{{ translate('NoSavedReports') }}</h3>
                        <div class="text-center"><a href="{{ Path }}reports/{{ constant('Pages::REPORTS_GENERATE') }}"
                                class="link-primary">{{ translate('GenerateReport') }}</a></div>
                    {% else %}
                        <div id="report-list">
                            {% set tableId = 'saved-reportsListTable' %}
                            <table class="table table-striped table-hover border-top w-100" id="{{ tableId }}">
                                <thead>
                                    <tr>
                                        <th>{{ translate('Title') }}</th>
                                        <th>{{ translate('Date') }}</th>
                                        <th>{{ translate('RunReport') }}</th>
                                        <th>{{ translate('EmailReport') }}</th>
                                        <th>{{ translate('Delete') }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for report in ReportList %}
                                        <tr reportId="{{ report.Id() }}">
                                            <td><span class="fw-bold">{{ (report.ReportName() ?? untitled)|escape_once }}</span></td>
                                            <td data-order="{{ format_date(date: report.DateCreated(), format: 'Y-m-d H:i:s') }}">
                                                <span
                                                    class="report-created-date fst-italic">{{ format_date(date: report.DateCreated()) }}</span>
                                            </td>

                                            <td class="report-action"><a href="#" class="runNow report link-primary"><i
                                                        class="bi bi-play-circle text-success me-1"></i>{{ translate('RunReport') }}
                                                </a></td>
                                            <td class="report-action"><a href="#" class="emailNow report link-primary"><span
                                                        class="bi bi-envelope me-1 icon"></span>{{ translate('EmailReport') }}</a>
                                            </td>
                                            <td class="report-action"><a href="#"
                                                    class="delete report link-danger text-decoration-none"><i
                                                        class="bi bi-trash3-fill me-1 icon remove"></i>{{ translate('Delete') }}</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div id="resultsDiv">
    </div>

    <div id="emailSent" class="alert alert-success no-show">
        <strong>{{ translate('ReportSent') }}</strong>N
    </div>

    <div class="modal fade" id="emailDiv" tabindex="-1" role="dialog" aria-labelledby="emailDialogLabel"
        aria-hidden="true">
        <div class="modal-dialog">
            <form id="emailForm" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="emailDialogLabel">{{ translate('EmailReport') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="fw-bold" for="emailTo">{{ translate('Email') }}</label>
                            <input id="emailTo" {{ formname('EMAIL') }} value="{{ UserEmail|escape_once }}" class="form-control" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary cancel"
                                data-bs-dismiss="modal">{{ translate('Cancel') }}</button>
                            <button id="btnSendEmail" type="button" class="btn btn-primary save"><i
                                    class="bi bi-envelope me-1"></i>{{ translate('EmailReport') }}
                            </button>
                            {{ indicator() }}
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="deleteDiv" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form id="deleteForm" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteLabel">{{ translate('Delete') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger">
                            {{ translate('DeleteWarning') }}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary cancel"
                            data-bs-dismiss="modal">{{ translate('Cancel') }}</button>
                        <button type="button" class="btn btn-danger save">{{ translate('Delete') }}</button>
                        {{ indicator() }}
                    </div>
                </div>
                {{ csrf_token() }}
            </form>
        </div>
    </div>

    <div id="indicator" class="d-none card shadow p-2">
        {{ include('wait-box.twig', {translateKey: 'Working'}) }}
    </div>

    {{ include('Reports/chart.twig') }}

    {{ include('javascript-includes.twig', {DataTable: true}) }}
    {{ datatable(tableId) }}
    {{ jsfile('ajax-helpers.js') }}
    {{ jsfile('reports/saved-reports.js') }}
    {{ jsfile('reports/chart.js') }}
    {{ jsfile('reports/common.js') }}

    <script type="text/javascript">
        $(document).ready(function() {
            var reportOptions = {
                generateUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Generate') }}&{{ constant('QueryStringKeys::REPORT_ID') }}=",
                emailUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Email') }}&{{ constant('QueryStringKeys::REPORT_ID') }}=",
                deleteUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Delete') }}&{{ constant('QueryStringKeys::REPORT_ID') }}=",
                printUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::PrintReport') }}&{{ constant('QueryStringKeys::REPORT_ID') }}=",
                csvUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Csv') }}&{{ constant('QueryStringKeys::REPORT_ID') }}="
            };

            var reports = new SavedReports(reportOptions);
            reports.init();

            var common = new ReportsCommon({
                scriptUrl: '{{ ScriptUrl|raw }}',
                chartOpts: {
                    dateAxisFormat: '{{ DateAxisFormat|raw }}'
                }
            });
            common.init();
        });
    </script>
</div>
{{ include('globalfooter.twig') }}
