<script type="text/javascript">
    $(document).ready(function() {
        var reportOptions = {
            userAutocompleteUrl: "{{ Path|raw }}ajax/autocomplete.php?type={{ constant('AutoCompleteType::User') }}",
            groupAutocompleteUrl: "{{ Path|raw }}ajax/autocomplete.php?type={{ constant('AutoCompleteType::Group') }}",
            customReportUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Generate') }}",
            printUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::PrintReport') }}&",
            csvUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Csv') }}&",
            saveUrl: "{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION') }}={{ constant('ReportActions::Save') }}"
        };

        var reports = new GenerateReports(reportOptions);
        reports.init();

        var common = new ReportsCommon({
            scriptUrl: '{{ ScriptUrl|raw }}',
            chartOpts: {
                dateAxisFormat: '{{ DateAxisFormat|raw }}'
            }
        });
        common.init();

        $('#resourceId').select2({
            placeholder: '{{ translate('AllResources')|raw }}'
        });
        $('#resourceTypeId').select2({
            placeholder: '{{ translate('AllResourceTypes')|raw }}'
        });
        $('#accessoryId').select2({
            placeholder: '{{ translate('AllAccessories')|raw }}'
        });
        $('#scheduleId').select2({
            placeholder: '{{ translate('AllSchedules')|raw }}'
        });
        $('#groupId').select2({
            placeholder: '{{ translate('AllGroups')|raw }}'
        });
    });

    //$('#user-filter, #participant-filter').clearable();
</script>

