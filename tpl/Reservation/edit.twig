{% extends 'Reservation/create.twig' %}

{% block header %}
    {{ include('globalheader.twig', {TitleKey: 'EditReservationHeading', TitleArgs: '', cssFiles: 'css/schedule.css', printCssFiles: 'css/reservation.print.css'}) }}
{% endblock %}

{% block reservationHeader %}
    {{ translate('EditReservationHeading', '') }}
    {% if RequiresApproval %}<span class="pendingApproval text-warning">({{ translate('PendingApproval') }}){% endif %}
{% endblock %}

    {% block submitButtons %}
        <div class="btn-group btn-group-sm btnMore">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"
                aria-expanded="false">
                <span class="d-none d-sm-inline"><i class="bi bi-plus-circle-fill me-1"></i>{{ translate('More') }}</span>
                <span class="d-sm-none"><i class="bi bi-three-dots-vertical"></i></span>
            </button>
            <ul class="dropdown-menu" role="menu">
                <li>
                    {% set icsUrl %}{{ Path }}export/{{ constant('Pages::CALENDAR_EXPORT') }}?{{ constant('QueryStringKeys::REFERENCE_NUMBER') }}={{ ReferenceNumber }}{% endset %}
                    <a href="{{ icsUrl }}" download="{{ icsUrl }}" class="dropdown-item">
                        <span class="bi bi-calendar3"></span>
                        {{ translate('AddToOutlook') }}</a>
                </li>
                <li>
                    <a href="http://www.google.com/calendar/event?action=TEMPLATE&text={{ ReservationTitle|urlencode }}&dates={{ formatdate(StartDate.ToUtc(), key: 'google') }}/{{ formatdate(EndDate.ToUtc(), key: 'google') }}&ctz={{ StartDate.Timezone() }}&details={{ Description|urlencode }}&location={{ Resource.Name|urlencode }}&trp=false&sprop=&sprop=name:"
                        target="_blank" rel="nofollow" class="dropdown-item">
                        <span class="bi bi-google"></span>
                        {{ translate('AddToGoogleCalendar') }}</a>
                </li>
                {% if EmailEnabled %}
                    <li>
                        <a href="#" class="btnSendEmail dropdown-item">
                            <span class="bi bi-envelope-fill"></span>
                            {{ translate('Email') }}</a>
                    </li>
                {% endif %}
                <li>
                    <a href="#" class="btnPrint dropdown-item">
                        <span class="bi bi-printer"></span>
                        {{ translate('Print') }}</a>
                </li>
                <li>
                    <a href="#" class="btnPDF dropdown-item">
                        <span class="bi bi-filetype-pdf"></span>
                        PDF</a>
                </li>
                <li>
                    <a class="dropdown-item"
                        href="{{ Path }}{{ constant('Pages::RESERVATION') }}?{{ constant('QueryStringKeys::SOURCE_REFERENCE_NUMBER') }}={{ ReferenceNumber }}&{{ constant('QueryStringKeys::REDIRECT') }}={{ ReturnUrl|urlencode }}">
                        <i class="bi bi-files"></i>
                        {{ translate('DuplicateReservation') }}</a>
                </li>

                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    {% if IsRecurring %}
                        <a href="#" class="delete prompt dropdown-item">
                            <span class="bi bi-x-lg text-danger remove icon"></span>
                            {{ translate('Delete') }}
                        </a>
                    {% else %}
                        <a href="#" class="triggerDeletePrompt delete prompt-single dropdown-item">
                            <span class="bi bi-x-lg text-danger remove icon"></span>
                            {{ translate('Delete') }}
                        </a>
                    {% endif %}
                </li>
            </ul>
        </div>

        {% if CheckInRequired and (not checkinAdminOnly or CanViewAdmin) %}
            <button type="button" class="btn btn-sm btn-warning btnCheckin"><i class="bi bi-box-arrow-in-right"></i>
                {{ translate('CheckIn') }}
                <span class="autoReleaseButtonMessage" data-autorelease-minutes="{{ AutoReleaseMinutes }}"> -
                    {{ translate('ReleasedIn') }} <span class="autoReleaseMinutes"></span> {{ translate('minutes') }}</span></button>
        {% endif %}
        {% if CheckOutRequired and (not checkoutAdminOnly or CanViewAdmin) %}
            <button type="button" class="btn btn-sm btn-warning btnCheckout"><i class="bi bi-box-arrow-in-right"></i>
                {{ translate('CheckOut') }}</button>
        {% endif %}
        {% if IsRecurring %}
            <button type="button" class="btn btn-sm btn-primary update prompt">
                <span class="bi bi-check-circle"></span>
                {{ translate('Update') }}
            </button>
            <div class="modal fade" id="updateButtons" tabindex="-1" role="dialog" aria-labelledby="updateButtonsLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="updateButtonsLabel">{{ translate('ApplyUpdatesTo') }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                        </div>
                        <div class="modal-body">
                            <div id="deleteRecurringButtons" class="d-none mb-3">
                                <div>{{ translate('DeleteReminderWarning') }}</div>
                                <div>
                                    <label for="deleteReasonRecurring">{{ translate('Reason') }} ({{ translate('Optional') }})</label>
                                    <textarea id="deleteReasonRecurring" class="form-control"></textarea>
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-sm-block">
                                <button type="button" class="btn btn-primary save btnUpdateThisInstance">
                                    <span class="bi bi-check-lg"></span>
                                    {{ translate('ThisInstance') }}
                                </button>
                                <button type="button" class="btn btn-primary save btnUpdateAllInstances">
                                    <span class="bi bi-check-square-fill"></span>
                                    {{ translate('AllInstances') }}
                                </button>
                                <button type="button" class="btn btn-primary save btnUpdateFutureInstances">
                                    <span class="bi bi-check2-square"></span>
                                    {{ translate('FutureInstances') }}
                                </button>
                                <button type="button" class="btn btn-outline-secondary">
                                    {{ translate('Cancel') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        {% else %}

            <button type="button" class="btn btn-sm btn-primary save update btnEdit">
                <span class="bi bi-check-circle"></span>
                {{ translate('Update') }}
            </button>
        {% endif %}

        <div id="deleteButtonPrompt" class="modal fade">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="updateButtonsLabel">{{ translate('Delete') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                    </div>
                    <div class="modal-body">
                        <div>{{ translate('DeleteReminderWarning') }}</div>
                        <div>
                            <label class="fw-bold" for="deleteReason">{{ translate('Reason') }}
                                ({{ translate('Optional') }})</label>
                            <textarea class="deleteReason form-control"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        {{ cancel_button(class: 'cancelDelete cancel') }}
                        {{ delete_button(class: 'confirmDelete delete save') }}
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}

    {% block ajaxMessage %}
        {{ translate('UpdatingReservation') }}...
    {% endblock %}

    {% block attachments %}
        {% if Attachments|default([])|length > 0 %}
            <div id="attachmentDiv" class="res-attachments border-top mt-2 pt-2">
                <span class="heading fw-bold">{{ translate('Attachments') }} ({{ Attachments|default([])|length }})</span>
                <a href="#" class="remove text-danger" id="btnRemoveAttachment">({{ translate('Remove') }})</a>
                <br />
                {% for attachment in Attachments %}
                    {% set attachmentUrl %}attachments/{{ constant('Pages::RESERVATION_FILE') }}?{{ constant('QueryStringKeys::ATTACHMENT_FILE_ID') }}={{ attachment.FileId() }}&{{ constant('QueryStringKeys::REFERENCE_NUMBER') }}={{ ReferenceNumber }}{% endset %}
                    <a href="{{ attachmentUrl }}" download="{{ attachmentUrl }}" target="_blank"
                        class="link-primary">{{ attachment.FileName() }}</a>
                    <input style="display: none;" type="checkbox" name="{{ constant('FormKeys::REMOVED_FILE_IDS') }}[{{ attachment.FileId() }}]" />
                {% endfor %}
            </div>
            <div class="modal-body">
                <div>{{ translate('DeleteReminderWarning') }}</div>
                <div>
                    <label for="deleteReason">{{ translate('Reason') }} ({{ translate('Optional') }})</label>
                    <textarea id="deleteReason" class="deleteReason form-control"></textarea>
                {% endif %}
    {% endblock %}

    {% block extras %}
        {% if AutoReleaseMinutes != null %}
            <input type="hidden" id="autoReleaseMinutes" value="{{ AutoReleaseMinutes }}" />
        {% endif %}

        <div class="modal fade" id="emailReservationPrompt" tabindex="-1" role="dialog"
            aria-labelledby="emailReservationLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form id="emailReservationForm" method="post" role="form" onkeypress="return event.keyCode != 13;">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="emailReservationLabel">{{ translate('EmailReservation') }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-hidden="true"></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label for="emailUserAutocomplete"
                                    class="visually-hidden">{{ translate('User') }}</label>
                                <input type="search" id="emailUserAutocomplete" name="email" class="form-control"
                                    placeholder="{{ translate('Email') }}" autofocus="autofocus" />
                            </div>

                            <div id="emailReservationList">

                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="btnSendReservation">
                                <span class="bi bi-envelope-fill"></span>
                                {{ translate('Email') }}
                            </button>
                            {{ cancel_button() }}
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endblock %}
