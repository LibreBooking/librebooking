{% import 'Reservation/_slot_macros_availability.twig' as slots %}
{# All of the slot display formatting #}

{# <div id="availability-highlighter"></div> #}
<div class="clearfix">
    <a href="#" id="" class="btnHideAvailability link-primary mb-3 float-end"><i
            class="bi bi-arrow-left-circle-fill me-1"></i>{{ translate('ReservationDetails') }}</a>
</div>
{# End slot display formatting #}
{% for date in BoundDates %}
    <div>
        <table id="reservations-{{ formatdate(date, format: 'Y-m-d') }}" data-date="{{ formatdate(date, format: 'Y-m-d') }}"
            class="reservations w-100">
            <thead>
                <tr>
                    <td class="resdate">{{ formatdate(date, key: 'schedule_daily') }}</td>
                    {% for period in DailyLayout.GetPeriods(date) %}
                        <td class="reslabel" colspan="{{ period.Span() }}"
                            data-start="{{ period.Begin().Hour() * 60 + period.Begin().Minute() }}"
                            data-end="{{ period.End().Hour() * 60 + period.End().Minute() }}">{{ period.Label(date)|escape_once }}</td>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for resource in Resources %}
                    {% set resourceSlots = DailyLayout.GetLayout(date, resource.GetId()) %}
                    <tr class="slots">
                        <td class="resourcename">
                            <span>{{ resource.GetName()|escape_once }}</span>
                        </td>
                        {% for slot in resourceSlots %}
                            {{ slots.dispatch(DisplaySlotFactory.GetFunction(slot, true), slot, null) }}
                        {% endfor %}
                    </tr>
                {% endfor %}

                {% set userSlots = DailyLayout.GetLayout(date, User.UserId * -1) %}
                <tr class="slots">
                    <td class="resourcename">
                        <span>{{ User.FullName|escape_once }}</span>
                    </td>
                    {% for slot in userSlots %}
                        {{ slots.dispatch(DisplaySlotFactory.GetFunction(slot, true), slot, null) }}
                    {% endfor %}
                </tr>

                {% for participant in Participants %}
                    {% set participantSlots = DailyLayout.GetLayout(date, participant.UserId * -1) %}
                    <tr class="slots">
                        <td class="resourcename">
                            <span>{{ participant.FullName|escape_once }}</span>
                        </td>
                        {% for slot in participantSlots %}
                            {{ slots.dispatch(DisplaySlotFactory.GetFunction(slot, true), slot, null) }}
                        {% endfor %}
                    </tr>
                {% endfor %}

                {% for invitee in Invitees %}
                    {% set inviteeSlots = DailyLayout.GetLayout(date, invitee.UserId * -1) %}
                    <tr class="slots">
                        <td class="resourcename">
                            <span>{{ invitee.FullName|escape_once }}</span>
                        </td>
                        {% for slot in inviteeSlots %}
                            {{ slots.dispatch(DisplaySlotFactory.GetFunction(slot, true), slot, null) }}
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endfor %}
<div class="clearfix">
    <a href="#" id="" class="btnHideAvailability link-primary mt-3 float-end"><i
            class="bi bi-arrow-left-circle-fill me-1"></i>{{ translate('ReservationDetails') }}</a>
</div>
