<script type="text/javascript">
    $(function() {
        var scopeOptions = {
            instance: '{{ constant('SeriesUpdateScope::ThisInstance') }}',
            full: '{{ constant('SeriesUpdateScope::FullSeries') }}',
            future: '{{ constant('SeriesUpdateScope::FutureInstances') }}'
        };

        var reservationOpts = {
            additionalResourceElementId: '{{ constant('FormKeys::ADDITIONAL_RESOURCES') }}',
            accessoryListInputId: '{{ constant('FormKeys::ACCESSORY_LIST') }}[]',
            returnUrl: '{{ ReturnUrl|raw }}', {# raw: JS string context #}
            scopeOpts: scopeOptions,
            createUrl: 'ajax/reservation_save.php',
            updateUrl: 'ajax/reservation_update.php',
            deleteUrl: 'ajax/reservation_delete.php',
            checkinUrl: 'ajax/reservation_checkin.php?action={{ constant('ReservationAction::Checkin') }}',
            checkoutUrl: 'ajax/reservation_checkin.php?action={{ constant('ReservationAction::Checkout') }}',
            waitlistUrl: 'ajax/reservation_waitlist.php',
            userAutocompleteUrl: "ajax/autocomplete.php?type={{ constant('AutoCompleteType::User') }}",
            groupAutocompleteUrl: "ajax/autocomplete.php?type={{ constant('AutoCompleteType::Group') }}",
            changeUserAutocompleteUrl: "ajax/autocomplete.php?type={{ constant('AutoCompleteType::MyUsers') }}",
            maxConcurrentUploads: '{{ MaxUploadCount }}',
            guestLabel: '({{ translate('Guest') }})',
            accessoriesUrl: 'ajax/available_accessories.php?{{ constant('QueryStringKeys::START_DATE') }}=[sd]&{{ constant('QueryStringKeys::END_DATE') }}=[ed]&{{ constant('QueryStringKeys::START_TIME') }}=[st]&{{ constant('QueryStringKeys::END_TIME') }}=[et]&{{ constant('QueryStringKeys::REFERENCE_NUMBER') }}=[rn]',
            resourcesUrl: 'ajax/unavailable_resources.php?{{ constant('QueryStringKeys::SCHEDULE_ID') }}={{ ScheduleId }}&{{ constant('QueryStringKeys::START_DATE') }}=[sd]&{{ constant('QueryStringKeys::END_DATE') }}=[ed]&{{ constant('QueryStringKeys::START_TIME') }}=[st]&{{ constant('QueryStringKeys::END_TIME') }}=[et]&{{ constant('QueryStringKeys::REFERENCE_NUMBER') }}=[rn]',
            creditsUrl: 'ajax/reservation_credits.php',
            creditsEnabled: '{{ CreditsEnabled }}',
            emailUrl: 'ajax/reservation_email.php?{{ constant('QueryStringKeys::REFERENCE_NUMBER') }}={{ ReferenceNumber }}',
            availabilityUrl: 'ajax/availability.php?{{ constant('QueryStringKeys::SCHEDULE_ID') }}={{ ScheduleId }}',
            maximumResources: {{ MaximumResources|default(0) }}
        };

        var reminderOpts = {
            reminderTimeStart: '{{ ReminderTimeStart }}',
            reminderTimeEnd: '{{ ReminderTimeEnd }}',
            reminderIntervalStart: '{{ ReminderIntervalStart }}',
            reminderIntervalEnd: '{{ ReminderIntervalEnd }}'
        };

        var reservation = new Reservation(reservationOpts);
        reservation.init('{{ UserId }}', '{{ format_date(StartDate, key: 'system_datetime', timezone: Timezone) }}', '{{ format_date(EndDate, key: 'system_datetime', timezone: Timezone) }}');

        var reminders = new Reminder(reminderOpts);
        reminders.init();

        {% for user in Participants %}
        reservation.addParticipant("{{ user.FullName|html_entity_decode|escape_js }}", "{{ user.UserId|escape_js }}");
        {% endfor %}

        {% for user in Invitees %}
        reservation.addInvitee("{{ user.FullName|html_entity_decode|escape_js }}", '{{ user.UserId }}');
        {% endfor %}

        {% for guest in ParticipatingGuests %}
        reservation.addParticipatingGuest('{{ guest|html_entity_decode|escape_js }}');
        {% endfor %}

        {% for guest in InvitedGuests %}
        reservation.addInvitedGuest('{{ guest|html_entity_decode|escape_js }}');
        {% endfor %}

        {% for accessory in Accessories %}
        reservation.addAccessory({{ accessory.AccessoryId }}, {{ accessory.QuantityReserved }}, "{{ accessory.Name|escape_js }}");
        {% endfor %}

        reservation.addResourceGroups({{ ResourceGroupsAsJson|raw }});{# raw: JS object literal context #}

        var recurOpts = {
            repeatType: '{{ RepeatType }}',
            repeatInterval: '{{ RepeatInterval }}',
            repeatMonthlyType: '{{ RepeatMonthlyType }}',
            repeatWeekdays: [{% for day in RepeatWeekdays %}{{ day }}, {% endfor %}],
            autoSetTerminationDate: $('#referenceNumber').val() != '',
            customRepeatExclusions: ['{{ formatdate(StartDate, key: 'system') }}']
        };

        var recurrence = new Recurrence(recurOpts);
        recurrence.init();

        recurrence.onChange(reservation.repeatOptionsChanged);

        {% for date in CustomRepeatDates %}
        recurrence.addCustomDate('{{ format_date(date, key: 'system', timezone: Timezone) }}',
        '{{ format_date(date, key: 'schedule_daily', timezone: Timezone) }}');
        {% endfor %}

        var ajaxOptions = {
            target: '#result', // target element(s) to be updated with server response
            beforeSubmit: reservation.preSubmit, // pre-submit callback
            success: reservation.showResponse // post-submit callback
        };

        $('#form-reservation').submit(function() {
            $(this).ajaxSubmit(ajaxOptions);
            return false;
        });

        $('#userName').bindUserDetails();

        translateTooltips();

    });
    $('.modal').on('shown.bs.modal', function() {
        $(this).find('[autofocus]').focus();
    });
</script>

<script>
    function translateTooltips() {
        var resourcesContainer = document.querySelector('#reservation-resources');
        var resources = [].slice.call(resourcesContainer.querySelectorAll('[data-bs-toggle="tooltip"]'));
        resources.forEach(function(resource) {
            var tooltipType = resource.getAttribute('data-bs-title');
            if (tooltipType === 'approval') {
                var tooltipText = "{{ translate('RequiresApproval') }}";
            }
            if (tooltipType === 'checkin') {
                var tooltipText ="{{ translate('RequiresCheckInNotification') }}";
            }
            if (tooltipType === 'autorelease') {
                var text = "{{ translate('AutoReleaseNotification', {0: '%s'}) }}";
                    var tooltipText = text.replace('%s', resource.getAttribute('data-autorelease'));
                }
                resource.setAttribute('data-bs-title', tooltipText);
                new bootstrap.Tooltip(resource);
            });
        }
    </script>

    {{ include('globalfooter.twig') }}
