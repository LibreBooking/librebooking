<script type="text/javascript">
    $(document).ready(function() {

        var participationOptions = {
            responseType: 'json'
        };

        var participation = new Participation(participationOptions);
        participation.initReservation();

        var approvalOptions = {
            responseType: 'json',
            url: "{{ Path }}ajax/reservation_approve.php",
            returnUrl: '{{ ReturnUrl|raw }}' {# raw: JS string context #}
        };

        var approval = new Approval(approvalOptions);
        approval.initReservation();

        var scopeOptions = {
            instance: '{{ constant('SeriesUpdateScope::ThisInstance') }}',
            full: '{{ constant('SeriesUpdateScope::FullSeries') }}',
            future: '{{ constant('SeriesUpdateScope::FutureInstances') }}'
        };

        var reservationOpts = {
            returnUrl: '{{ ReturnUrl|raw }}', {# raw: JS string context #}
            scopeOpts: scopeOptions,
            deleteUrl: 'ajax/reservation_delete.php',
            checkinUrl: 'ajax/reservation_checkin.php?action={{ constant('ReservationAction::Checkin') }}',
            checkoutUrl: 'ajax/reservation_checkin.php?action={{ constant('ReservationAction::Checkout') }}',
            userAutocompleteUrl: "ajax/autocomplete.php?type={{ constant('AutoCompleteType::User') }}",
            changeUserAutocompleteUrl: "ajax/autocomplete.php?type={{ constant('AutoCompleteType::MyUsers') }}",
            waitlistUrl: 'ajax/reservation_waitlist.php',
        };
        var reservation = new Reservation(reservationOpts);
        reservation.init('{{ UserId }}',
            '{{ format_date(StartDate, key: 'system_datetime', timezone: Timezone) }}',
            '{{ format_date(EndDate, key: 'system_datetime', timezone: Timezone) }}'
        );

        var ajaxOptions = {
            target: '#result', // target element(s) to be updated with server response
            beforeSubmit: reservation.preSubmit, // pre-submit callback
            success: reservation.showResponse // post-submit callback
        };

        $('#form-reservation').submit(function() {
            $(this).ajaxSubmit(ajaxOptions);
            return false;
        });

    });
</script>
