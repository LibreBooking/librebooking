{{ include('globalheader.twig') }}

<div id="page-install">
    <div class="card shadow">
        <div class="card-body">
            <h1 class="border-bottom text-center mb-3">{{ translate('InstallApplication') }}</h1>

            {% if ShowScriptUrlWarning is defined and ShowScriptUrlWarning %}
                <div class="alert alert-danger">
                    {{ translate('ScriptUrlWarning', [CurrentScriptUrl, SuggestedScriptUrl]) }}
                </div>
            {% endif %}

            <div>
                <form class="register" method="post" action="{{ server.SCRIPT_NAME }}" role="form">

                    {% if ShowInvalidPassword is defined and ShowInvalidPassword %}
                        <div class="error alert alert-danger">{{ translate('IncorrectInstallPassword') }}</div>
                    {% endif %}

                    {% if InstallPasswordMissing is defined and InstallPasswordMissing %}
                        <div class="error alert alert-info">
                            <div>{{ translate('SetInstallPassword') }}</div>

                            <div>
                                {{ translate('InstallPasswordInstructions', [ConfigPath, ConfigSetting, SuggestedInstallPassword]) }}
                            </div>
                        </div>
                    {% endif %}

                    {% if ShowUpToDateMessage is defined and ShowUpToDateMessage %}
                        <div class="error mb-3">
                            <h3>{{ translate('NoUpgradeNeeded') }}</h3>
                        </div>
                    {% endif %}

                    {% if ShowPasswordPrompt is defined and ShowPasswordPrompt %}
                        <div class="form-group">
                            <div>{{ translate('ProvideInstallPassword') }}</div>
                            <div>{{ translate('InstallPasswordLocation', [ConfigPath, ConfigSetting]) }}</div>
                            <div>{{ textbox(type: 'password', name: 'INSTALL_PASSWORD', attributes: {size: '20'}) }}</div>
                            <div>
                                <button type="submit" name="" class="btn btn-outline-secondary mt-2"
                                    value="submit">{{ translate('Next') }}<i
                                        class="bi bi-arrow-right-circle-fill ms-1"></i></button>
                            </div>
                        </div>
                    {% endif %}

                    {% if ShowDatabasePrompt is defined and ShowDatabasePrompt %}
                        <div class="list-group-numbered">
                            <li class="list-group-item mb-3">{{ translate('VerifyInstallSettings', [ConfigPath]) }}
                                <div class="ms-3">
                                    <div><span class="fw-bold">{{ translate('DatabaseName') }}:</span> {{ dbname }}</div>
                                    <div><span class="fw-bold">{{ translate('DatabaseUser') }}:</span> {{ dbuser }}</div>
                                    <div><span class="fw-bold">{{ translate('DatabaseHost') }}:</span> {{ dbhost }}</div>
                                </div>
                            </li>
                            <li class="list-group-item">{{ translate('DatabaseCredentials') }}
                                <div class="form-group ms-3">
                                    <label class="fw-bold" for="dbUser">{{ translate('MySQLUser') }}</label>
                                    {{ textbox(name: 'INSTALL_DB_USER', id: 'dbUser', attributes: {size: '20'}) }}
                                </div>
                                <div class="form-group ms-3 mb-3">
                                    <label class="fw-bold" for="dbPassword">{{ translate('Password') }}</label>
                                    {{ textbox(type: 'password', name: 'INSTALL_DB_PASSWORD', id: 'dbPassword', attributes: {size: '20'}) }}
                                </div>
                            </li>
                            {% if ShowInstallOptions is defined and ShowInstallOptions %}
                                <li class="list-group-item mb-3"><span
                                        class="fst-italic">{{ translate('InstallOptionsWarning') }}</span>
                                    <div class="ms-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="create_database"
                                                name="create_database" />
                                            <label class="form-check-label" for="create_database">{{ translate('CreateDatabase') }}
                                                ({{ dbname }})<span
                                                    class="text-danger fw-bold ms-1">{{ translate('DataWipeWarning') }}</span></label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="create_user"
                                                name="create_user" />
                                            <label class="form-check-label" for="create_user">
                                                {{ translate('CreateDatabaseUser') }}
                                                ({{ dbuser }})</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="create_sample_data"
                                                name="create_sample_data" />
                                            <label class="form-check-label" for="create_sample_data">
                                                {{ translate('PopulateExampleData') }}</label>
                                        </div>
                                        <div class="form-check ms-4">
                                            <input class="form-check-input" type="checkbox" id="create_large_sample_data"
                                                name="create_large_sample_data" />
                                            <label class="form-check-label" for="create_large_sample_data">
                                                {{ translate('PopulateLargeExampleData') }}</label>
                                        </div>
                                    </div>
                                </li>
                                <div>
                                    <button type="submit" name="run_install" class="btn btn-outline-secondary"
                                        value="submit">{{ translate('RunInstallation') }}<i
                                            class="bi bi-arrow-right-circle-fill ms-1"></i>
                                </div>
                            {% endif %}
                            {% if ShowUpgradeOptions is defined and ShowUpgradeOptions %}
                                <li class="list-group-item">
                                    {{ translate('UpgradeNotice', [CurrentVersion, TargetVersion]) }}
                                    <div class="my-3">
                                        <button type="submit" name="run_upgrade" class="btn btn-outline-secondary"
                                            value="submit">{{ translate('RunUpgrade') }}<i
                                                class="bi bi-arrow-right-circle-fill ms-1"></i>
                                    </div>
                                </li>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="no-style">
                        {% for result in installresults %}
                            <div>{{ translate('Executing') }}: {{ result.taskName }}</div>
                            {% if result.WasSuccessful() %}
                                <div class="alert alert-success">{{ translate('Success') }}</div>
                            {% else %}
                                <div class="alert alert-danger">
                                    {{ translate('StatementFailed') }}
                                    <div class="no-style">
                                        <div>{{ translate('SQLStatement') }}
                                            <pre>{{ result.sqlText }}</pre>
                                        </div>
                                        <div>{{ translate('ErrorCode') }}
                                            <pre>{{ result.sqlErrorCode }}</pre>
                                        </div>
                                        <div>{{ translate('ErrorText') }}
                                            <pre>{{ result.sqlErrorText }}</pre>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                        <div>&nbsp;</div>
                        <div>
                            {% if InstallCompletedSuccessfully is defined and InstallCompletedSuccessfully %}
                                {{ translate('InstallationSuccess') }}
                                <br />
                                <a href="{{ Path }}{{ constant('Pages::REGISTRATION') }}" class="link-primary">{{ translate('Register') }}</a>
                                {{ translate('RegisterAdminUser', [ConfigPath]) }}
                                <br />
                                <br />
                                <a href="{{ Path }}{{ constant('Pages::LOGIN') }}" class="link-primary">{{ translate('Login') }}</a>
                                {{ translate('LoginWithSampleAccounts') }}
                            {% endif %}
                            {% if UpgradeCompletedSuccessfully is defined and UpgradeCompletedSuccessfully %}
                                {{ translate('InstalledVersion', [TargetVersion]) }}
                                <h3><a href="configure.php" class="link-primary">{{ translate('InstallUpgradeConfig') }}</a>
                                </h3>
                            {% endif %}
                            {% if InstallFailed is defined and InstallFailed %}
                                {{ translate('InstallationFailure') }}
                            {% endif %}
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

{{ include('javascript-includes.twig') }}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sampleData = document.getElementById('create_sample_data');
        const largeSampleData = document.getElementById('create_large_sample_data');
        if (sampleData && largeSampleData) {
            largeSampleData.addEventListener('change', function () {
                if (this.checked) {
                    sampleData.checked = true;
                }
            });
            sampleData.addEventListener('change', function () {
                if (!this.checked) {
                    largeSampleData.checked = false;
                }
            });
        }
    });
</script>
{{ include('globalfooter.twig') }}
