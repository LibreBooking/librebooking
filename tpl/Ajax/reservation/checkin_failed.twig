<div>
    <div id="reservation-response-image">
        <i class="bi bi-exclamation-triangle-fill fs-1 text-danger"></i>
    </div>

    <div id="failed-message" class="reservation-message fw-bold fs-4">
        {% if IsCheckingIn %}
            {{ translate('CheckInFailed') }}
        {% else %}
            {{ translate('CheckOutFailed') }}
        {% endif %}
    </div>

    <div class="error">
        {% for each in Errors %}
            <div>{{ each|escape_once|nl2br }}</div>
        {% endfor %}
    </div>

    <div>
        <button id="btnSaveFailed" class="btn btn-warning text-white"><i
                class="bi bi-arrow-left-circle-fill me-1"></i>{{ translate('Close') }}</button>
    </div>

</div>
