<!-- tpl/Schedule/schedule.tpl -->
{# main schedule page (standard grid host).
   The literal comment above mirrors the Smarty .tpl first line byte-for-byte. #}
{% import 'Schedule/_slot_macros.twig' as slot %}
{% block header %}
    {{ include('globalheader.twig', {Select2: true, DatePicker: true, cssFiles: 'assets/vendor/jqtree/1.8.11/css/jqtree.css,css/schedule.css', printCssFiles: 'css/schedule.print.css'}) }}
{% endblock %}

<div id="page-schedule">

    {% if ShowResourceWarning is defined and ShowResourceWarning %}
        <div class="alert alert-warning no-resource-warning"><i class="bi bi-exclamation-triangle-fill"></i>
            {{ translate('NoResources') }}
            <a class="alert-link" href="admin/manage_resources.php">{{ translate('AddResource') }}</a>
    </div> {% endif %}

    {% if CanViewAdmin %}
        <div id="slow-schedule-warning" class="alert alert-warning d-flex align-items-center d-none" role="alert">
            <div>
                <p>We noticed this page is taking a long time to load. To speed ths page up, try
                    reducing the number of <a class="alert-link" href="admin/manage_resources.php">resources</a> on this
                    schedule or
                    reducing the number of <a class="alert-link" href="admin/manage_schedules.php">days</a> being shown.
                </p>
                <p class="mb-0">
                    This page is taking <span id="warning-time"></span> seconds to load
                    <span id="warning-resources"></span> resources for <span id="warning-days"></span> days.
                    <button type="button" class="close close-forever btn btn-link alert-link"
                        aria-label="Do not show again">
                        <span aria-hidden="true">Do not show again</span>
                    </button>
                </p>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    {% if IsAccessible %}
        {# Computed at page scope so they are available both inside the
           schedule_control block (date navigation) and later in the
           fetchReservationsForm (Twig block-scoped {% set %} does not leak). #}
        {% set TodaysDate = now() %}
        {% set FirstDate = DisplayDates.GetBegin() %}
        {% set LastDate = DisplayDates.GetEnd().AddDays(-1) %}

        {# Captured at page scope (Smarty stored this in {$smarty.capture}, which is
           globally accessible); it is emitted once inside schedule_control and once
           again near the bottom of the page. #}
        {% set date_navigation %}
            {% if HideSchedule is not defined or not HideSchedule %}
                <div class="schedule-dates d-flex justify-content-center mt-2 fs-5 gap-2">
                    <a href="#" class="change-date link-primary" data-year="{{ TodaysDate.Year() }}"
                        data-month="{{ TodaysDate.Month() }}" data-day="{{ TodaysDate.Day() }}" aria-label="{{ translate('Today') }}">
                        <i class="bi bi-house-fill" aria-hidden="true"></i>
                    </a>
                    <a href="#" class="change-date link-primary" data-year="{{ PreviousDate.Year() }}"
                        data-month="{{ PreviousDate.Month() }}" data-day="{{ PreviousDate.Day() }}"
                        aria-label="{{ translate('PreviousWeek') }}">
                        <i class="bi bi-arrow-left-circle-fill" aria-hidden="true"></i>
                    </a>
                    {{ formatdate(FirstDate) }}
                    {% if ShowWeekNumbers %}({{ FirstDate.WeekNumber() }}){% endif %}
                    -
                    {{ formatdate(LastDate) }}
                    {% if ShowWeekNumbers %}({{ LastDate.WeekNumber() }}){% endif %}
                    <a href="#" class="change-date link-primary" data-year="{{ NextDate.Year() }}" data-month="{{ NextDate.Month() }}"
                        data-day="{{ NextDate.Day() }}" aria-label="{{ translate('NextWeek') }}">
                        <i class="bi bi-arrow-right-circle-fill" aria-hidden="true"></i>
                    </a>
                </div>
                {% if ShowFullWeekLink %}
                    <div class="d-flex justify-content-center fs-5">
                        <a class="link-primary" href="{{ add_querystring('SHOW_FULL_WEEK', '1') }}"
                            id="showFullWeek">({{ translate('ShowFullWeek') }})</a>
                    </div>
                {% endif %}
            {% endif %}
        {% endset %}

        {% block schedule_control %}
            <div class="row">
                {% set titleWidth = 'col-sm-12 col-12' %}
                {% if HideSchedule is not defined or not HideSchedule %}
                    {% set titleWidth = 'col-sm-6 col-12' %}
                    <div id="schedule-actions" class="col-sm-3 col-12">
                        {% block actions %}
                            <div class="d-flex align-items-center mb-2">
                                <div class="me-4 d-flex align-items-center gap-2">
                                    <a href="#" id="print_schedule" class="link-primary me-1" title="{{ translate('Print') }}">
                                        <i class="bi bi-printer schedule_icon"></i>
                                    </a>
                                    {% if LoggedIn %}
                                        <a href="#" id="make_default" class="link-primary" title="{{ translate('MakeDefaultSchedule') }}">
                                            <i class="bi bi-star-fill schedule_icon"></i>
                                        </a>
                                    {% endif %}
                                </div>
                                <a href="#"
                                    class="schedule-style me-2 d-inline-flex align-items-center{% if ScheduleStyle == constant('ScheduleStyle::Standard').value %} active{% endif %}"
                                    id="schedule_standard" schedule-display="{{ constant('ScheduleStyle::Standard').value }}"
                                    title="{% if IsMobile and not IsTablet %}{{ translate('CondensedWeekScheduleDisplay') }}{% else %}{{ translate('StandardScheduleDisplay') }}{% endif %}">
                                    <img class="schedule_icon shadow-sm" src="{% if IsMobile and not IsTablet %}img/table-week.png{% else %}img/table.png{% endif %}"
                                        alt="{% if IsMobile and not IsTablet %}{{ translate('CondensedWeekScheduleDisplay') }}{% else %}{{ translate('StandardScheduleDisplay') }}{% endif %}" />
                                </a>
                                <a href="#"
                                    class="schedule-style me-2 d-inline-flex align-items-center{% if ScheduleStyle == constant('ScheduleStyle::Tall').value %} active{% endif %}"
                                    id="schedule_tall" schedule-display="{{ constant('ScheduleStyle::Tall').value }}"
                                    title="{{ translate('TallScheduleDisplay') }}">
                                    <img class="schedule_icon shadow-sm" src="img/table-tall.png"
                                        alt="{{ translate('TallScheduleDisplay') }}" />
                                </a>
                                {% if not IsMobile or IsTablet %}
                                <a href="#"
                                    class="schedule-style d-inline-flex me-2 align-items-center{% if ScheduleStyle == constant('ScheduleStyle::Wide').value %} active{% endif %}"
                                    id="schedule_wide" schedule-display="{{ constant('ScheduleStyle::Wide').value }}"
                                    title="{{ translate('WideScheduleDisplay') }}">
                                    <img class="schedule_icon shadow-sm" src="img/table-wide.png"
                                        alt="{{ translate('WideScheduleDisplay') }}" />
                                </a>
                                <a href="#"
                                    class="schedule-style d-inline-flex align-items-center{% if ScheduleStyle == constant('ScheduleStyle::CondensedWeek').value %} active{% endif %}"
                                    id="schedule_week" schedule-display="{{ constant('ScheduleStyle::CondensedWeek').value }}"
                                    title="{{ translate('CondensedWeekScheduleDisplay') }}">
                                    <img class="schedule_icon shadow-sm" src="img/table-week.png"
                                        alt="{{ translate('CondensedWeekScheduleDisplay') }}" />
                                </a>
                                {% endif %}
                            </div>
                            {% if SubscriptionUrl is defined and SubscriptionUrl != null and ShowSubscription and LoggedIn %}
                                {% set atomUrl = SubscriptionUrl.GetAtomUrl() %}
                                {% set icalUrl = SubscriptionUrl.GetWebcalUrl() %}
                                <div class="d-flex align-items-center"><i class="bi bi-rss-fill link-primary me-1"></i>
                                    <a class="link-primary me-1" target="_blank" href="{{ atomUrl|e('html') }}"
                                        title="{{ translate('UrlCopiedToClipboard') }}"
                                        onclick="copyUrlToClipboard('{{ atomUrl|escape_js|e('html') }}'); return false;">Atom</a>
                                    <div class="vr me-1"></div>
                                    <a class="link-primary" target="_blank" href="{{ icalUrl|e('html') }}"
                                        title="{{ translate('UrlCopiedToClipboard') }}"
                                        onclick="copyUrlToClipboard('{{ icalUrl|escape_js|e('html') }}'); return false;">iCalendar</a>
                                </div>
                            {% endif %}
                        {% endblock %}
                    </div>
                {% endif %}

                <div id="schedule-title" class="schedule_title {{ titleWidth }}">
                    <div class="d-flex justify-content-center">
                        {% if Schedules|length > 1 %}
                            <label for="schedules" class="visually-hidden">{{ translate('Schedules') }}</label>
                            <select id="schedules" class="form-select w-auto">
                                {% for schedule in Schedules %}
                                    <option value="{{ schedule.GetId() }}" {% if schedule.GetId() == ScheduleId %}selected="selected"
                                        {% endif %}>
                                        {{ schedule.GetName()|escape_once }}</option>
                                {% endfor %}
                            </select>
                        {% endif %}
                        <a class="link-primary" href="#" id="calendar_toggle" title="{{ translate('ShowHideNavigation') }}"
                            data-bs-toggle="collapse" data-bs-target="#individualDates" aria-expanded="false"
                            aria-controls="individualDates">
                            <span class="bi bi-calendar schedule_icon"></span>
                            <span class="visually-hidden">{{ translate('ShowHideNavigation') }}</span>
                        </a>
                    </div>
                </div>
            </div>

            <div id="individualDates" class="collapse mb-3">
                <div class="d-flex justify-content-center align-items-center mt-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="multidateselect" />
                        <label class="form-check-label" for="multidateselect">{{ translate('SpecificDates') }}</label>
                    </div>
                </div>
                <div class="text-center" id="individualDatesList"></div>
                <button class="btn btn-sm btn-primary mx-auto" href="#" id="individualDatesGo">
                    <i class="bi bi-search me-1"></i>{{ translate('SpecificDates') }}
                </button>
                <div class="d-flex justify-content-center align-items-center">
                    <div id="datepicker" class="collapse"></div>
                </div>
            </div>

            {{ date_navigation }}
        {% endblock %}

        {% if ScheduleAvailabilityEarly is defined and ScheduleAvailabilityEarly %}
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle-fill"></i> {{ translate('ScheduleAvailabilityEarly') }}
                <a href="#" class="change-date alert-link" data-year="{{ ScheduleAvailabilityStart.Year() }}"
                    data-month="{{ ScheduleAvailabilityStart.Month() }}" data-day="{{ ScheduleAvailabilityStart.Day() }}">
                    {{ format_date(ScheduleAvailabilityStart, timezone) }}
                </a> -
                <a href="#" class="change-date alert-link" data-year="{{ ScheduleAvailabilityEnd.Year() }}"
                    data-month="{{ ScheduleAvailabilityEnd.Month() }}" data-day="{{ ScheduleAvailabilityEnd.Day() }}">
                    {{ format_date(ScheduleAvailabilityEnd, timezone) }}
                </a>
            </div>
        {% endif %}

        {% if ScheduleAvailabilityLate is defined and ScheduleAvailabilityLate %}
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle-fill"></i>
                {{ translate('ScheduleAvailabilityLate') }}
                <a href="#" class="change-date alert-link" data-year="{{ ScheduleAvailabilityStart.Year() }}"
                    data-month="{{ ScheduleAvailabilityStart.Month() }}" data-day="{{ ScheduleAvailabilityStart.Day() }}">
                    {{ format_date(ScheduleAvailabilityStart, timezone) }}
                </a> -
                <a href="#" class="change-date alert-link" data-year="{{ ScheduleAvailabilityEnd.Year() }}"
                    data-month="{{ ScheduleAvailabilityEnd.Month() }}" data-day="{{ ScheduleAvailabilityEnd.Day() }}">
                    {{ format_date(ScheduleAvailabilityEnd, timezone) }}
                </a>
            </div>
        {% endif %}

        {% if HideSchedule is not defined or not HideSchedule %}
            {% block legend %}
                <div class="schedule-legend mt-3">
                    <div class="d-none d-sm-flex justify-content-center flex-wrap gap-1 text-center">
                        <div
                            class="legend reservable border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                            {{ translate('Reservable') }}</div>
                        <div
                            class="legend unreservable border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                            {{ translate('Unreservable') }}</div>
                        <div
                            class="legend reserved border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                            {{ translate('Reserved') }}</div>
                        {% if LoggedIn %}
                            <div
                                class="legend reserved mine border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                                {{ translate('MyReservation') }}
                            </div>
                            <div
                                class="legend reserved participating border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                                {{ translate('Participant') }}</div>
                        {% endif %}
                        <div
                            class="legend reserved pending border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                            {{ translate('Pending') }}</div>
                        <div
                            class="legend pasttime border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                            {{ translate('Past') }}</div>
                        <div
                            class="legend restricted border border-dark-subtle rounded-2 d-flex align-items-center justify-content-center lh-sm py-1">
                            {{ translate('Restricted') }}</div>
                    </div>
                </div>
            {% endblock %}

            <div>
                <a href="#" title="Show Reservation Filter" class="toggle-sidebar link-primary"><i
                        class="bi bi-funnel-fill me-1"></i>{{ translate('ResourceFilter') }}
                    <i id="restore-sidebar" class="bi bi-chevron-double-right"></i></a>
            </div>
            <div class="row g-2">
                <div id="reservations-left" class="col-md-2 col-sm-12">
                    <div class="card h-100">
                        <div
                            class="reservations-left-header card-header d-flex justify-content-between align-items-center px-3 py-2">
                            <h5 class="card-title text-center mb-0">{{ translate('Filter') }}</h5>
                            <a href="#" class="toggle-sidebar link-primary" title="Hide Reservation Filter">
                                <i class="bi bi-x-circle-fill"></i>
                                <span class="visually-hidden">Hide Reservation Filter</span>
                            </a>
                        </div>

                        <div class="reservations-left-content card-body">
                            <form method="get" role="form" id="advancedFilter">

                                {% if ResourceAttributes|length + ResourceTypeAttributes|length > 5 %}
                                    <div>
                                        <input type="submit" value="{{ translate('Filter') }}" class="btn btn-primary btn-sm"
                                            {{ formname('SUBMIT') }} />
                                    </div>
                                {% endif %}

                                <div>
                                    <div id="resourceGroups"></div>
                                </div>

                                <div id="resettable">
                                    {% if CanViewUsers %}
                                        <div class="form-group mb-2">
                                            <label for="ownerFilter" class="fw-bold">{{ translate('Owner') }}</label>
                                            <input type="search" id="ownerFilter" class="form-control form-control-sm search"
                                                {{ formname('OWNER_TEXT') }} value="{% if OwnerText is defined %}{{ OwnerText|escape_once }}{% endif %}" />
                                            <input {{ formname('USER_ID') }} id="ownerId" type="hidden" value="{{ OwnerId }}" />
                                            <span class="searchclear searchclear-label" ref="ownerFilter,ownerId"></span>
                                        </div>
                                        {% if AllowParticipation %}
                                            <div class="form-group mb-2">
                                                <label for="participantFilter" class="fw-bold">{{ translate('Participant') }}</label>
                                                <input type="search" id="participantFilter" class="form-control form-control-sm search"
                                                    {{ formname('PARTICIPANT_TEXT') }}
                                                    value="{% if ParticipantText is defined %}{{ ParticipantText|escape_once }}{% endif %}" />
                                                <input {{ formname('PARTICIPANT_ID') }} id="participantId" type="hidden"
                                                    value="{{ ParticipantId }}" />
                                                <span class="searchclear searchclear-label"
                                                    ref="participantFilter,participantId"></span>
                                            </div>
                                        {% endif %}
                                    {% endif %}
                                    <div class="form-group mb-2">
                                        <label for="maxCapactiy" class="fw-bold">{{ translate('MinimumCapacity') }}</label>
                                        <input type="number" min="0" id="maxCapactiy" size="5" maxlength="5"
                                            class="form-control form-control-sm" {{ formname('MAX_PARTICIPANTS') }}
                                            value="{{ MaxParticipantsFilter }}" />
                                    </div>

                                    <div class="form-group mb-2">
                                        <label for="resourceType" class="fw-bold">{{ translate('ResourceType') }}</label>
                                        <select id="resourceType" {{ formname('RESOURCE_TYPE_ID') }}
                                            class="form-select form-select-sm">
                                            <option value="">- {{ translate('All') }} -</option>
                                            {{ object_html_options(options: ResourceTypes, label: 'Name', key: 'Id', selected: ResourceTypeIdFilter) }}
                                        </select>
                                    </div>

                                    {% for attribute in ResourceAttributes %}
                                        {{ control('AttributeControl', {attribute: attribute, searchmode: true, namePrefix: 'r', class: 'customAttribute mb-2'}) }}
                                    {% endfor %}

                                    {% for attribute in ResourceTypeAttributes %}
                                        {{ control('AttributeControl', {attribute: attribute, searchmode: true, namePrefix: 'rt', class: 'customAttribute mb-2'}) }}
                                    {% endfor %}

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-block btn-sm"
                                            value="submit">{{ translate('Filter') }}</button>
                                        <button id="show_all_resources" type="button"
                                            class="btn btn-outline-secondary btn-sm">{{ translate('ClearFilter') }}</button>
                                    </div>
                                </div>

                                <input type="hidden" name="sid" value="{{ ScheduleId }}" />
                                <input type="hidden" name="sds"
                                    value="{% for d in SpecificDates %}{{ d.Format('Y-m-d') }},{% endfor %}" />
                                <input type="hidden" name="sd" value="{{ DisplayDates.GetBegin().Format('Y-m-d') }}" />
                                <input type="hidden" {{ formname('SUBMIT') }} value="true" />
                                <input type="hidden" name="clearFilter" id="clearFilter" value="0" />
                            </form>
                        </div>
                    </div>
                </div>

                <div id="reservations" class="col-md-10 col-sm-12">
                    {% block reservations %}
                        {{ include('Schedule/schedule-reservations-grid.twig') }}
                    {% endblock %}
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="error">{{ translate('NoResourcePermission') }}</div>
    {% endif %}

    <input type="hidden" value="{{ ScheduleId }}" id="scheduleId" />

    <div class="mt-2">
        {{ date_navigation }}
    </div>

</div>

<form id="moveReservationForm">
    <input id="moveReferenceNumber" type="hidden" {{ formname('REFERENCE_NUMBER') }} />
    <input id="moveStartDate" type="hidden" {{ formname('BEGIN_DATE') }} />
    <input id="moveResourceId" type="hidden" {{ formname('RESOURCE_ID') }} />
    <input id="moveSourceResourceId" type="hidden" {{ formname('ORIGINAL_RESOURCE_ID') }} />
    {{ csrf_token() }}
</form>

<form id="fetchReservationsForm">
    <input type="hidden" {{ formname('BEGIN_DATE') }} value="{{ formatdate(FirstDate, null, null, 'system') }}" />
    <input type="hidden" {{ formname('END_DATE') }} value="{{ formatdate(LastDate, null, null, 'system') }}" />
    <input type="hidden" {{ formname('SCHEDULE_ID') }} value="{{ ScheduleId }}" />
    {% for d in SpecificDates %}
        <input type="hidden" {{ formname('SPECIFIC_DATES', true) }} value="{{ formatdate(d, null, null, 'system') }}" />
    {% endfor %}
    <input type="hidden" {{ formname('MIN_CAPACITY') }} value="{% if MinCapacityFilter is defined %}{{ MinCapacityFilter }}{% endif %}" />
    <input type="hidden" {{ formname('RESOURCE_TYPE_ID') }} value="{{ ResourceTypeIdFilter }}" />
    {% for attribute in ResourceAttributes %}
        <input type="hidden" name="RESOURCE_ATTRIBUTE_ID[{{ attribute.Id() }}]" value="{{ attribute.Value()|escape_once }}" />
    {% endfor %}
    {% for attribute in ResourceTypeAttributes %}
        <input type="hidden" name="RESOURCE_TYPE_ATTRIBUTE_ID[{{ attribute.Id() }}]" value="{{ attribute.Value()|escape_once }}" />
    {% endfor %}
    {% for id in ResourceIds %}
        <input type="hidden" {{ formname('RESOURCE_ID', true) }} value="{{ id }}" />
    {% endfor %}
    <input type="hidden" {{ formname('USER_ID') }} value="{{ UserIdFilter }}" />
    <input type="hidden" {{ formname('PARTICIPANT_ID') }} value="{{ ParticipantIdFilter }}" />
    {{ csrf_token() }}
</form>

<div id="loading-schedule" class="d-none d-flex align-items-center gap-2 p-3 border rounded-2 bg-white
opacity-75">
    <div class="spinner-border" role="status">
        <span class="visually-hidden">{{ translate('Working') }}</span>
    </div>
    <span aria-hidden="true">{{ translate('Working') }}</span>
</div>

{{ include('javascript-includes.twig', {Select2: true, Clear: true, DatePicker: true}) }}

{% block scripts_before %}

{% endblock %}

{{ vendor_js(src: 'html2canvas-pro/2.0.2/js/html2canvas-pro.min.js') }}
{{ jsfile(src: 'reservationPopup.js') }}
{{ jsfile(src: 'schedule.js') }}
{{ jsfile(src: 'resourcePopup.js') }}
{{ vendor_js(src: 'jqtree/1.8.11/js/tree.jquery.js') }}
{{ vendor_js(src: 'jquery-cookie/1.3.1/js/jquery.cookie.js') }}
{{ jsfile(src: 'autocomplete.js') }}
{{ jsfile(src: 'ajax-helpers.js') }}
<script type="text/javascript">
    let resourceMaxConcurrentReservations = {};
    {% for r in Resources %}
        resourceMaxConcurrentReservations[{{ r.GetId() }}] = {{ r.MaxConcurrentReservations }};
    {% endfor %}

    const scheduleOpts = {
        reservationUrlTemplate: "{{ Path|raw }}{{ constant('Pages::RESERVATION')|raw }}?{{ constant('QueryStringKeys::REFERENCE_NUMBER')|raw }}=[referenceNumber]",
        summaryPopupUrl: "{{ Path|raw }}ajax/respopup.php",
        setDefaultScheduleUrl: "{{ Path|raw }}{{ constant('Pages::PROFILE')|raw }}?action=changeDefaultSchedule&{{ constant('QueryStringKeys::SCHEDULE_ID')|raw }}=[scheduleId]",
        cookieName: "{{ CookieName }}",
        scheduleId: "{{ ScheduleId|escape_js }}",
        scriptUrl: '{{ ScriptUrl }}',
        selectedResources: [{{ ResourceIds|join(',') }}],
        specificDates: [{% for d in SpecificDates %}'{{ d.Format('Y-m-d') }}',{% endfor %}],
        updateReservationUrl: "{{ Path|raw }}ajax/reservation_move.php",
        lockTableHead: "{% if LockTableHead is defined %}{{ LockTableHead }}{% endif %}",
        disableSelectable: "{{ IsMobile }}",
        reservationLoadUrl: "{{ Path|raw }}{{ constant('Pages::SCHEDULE')|raw }}?{{ constant('QueryStringKeys::DATA_REQUEST')|raw }}=reservations",
        scheduleStyle: "{{ ScheduleStyle }}",
        midnightLabel: "{{ formatdate(now().GetDate(), null, null, 'period_time') }}",
        isMobileView: "{{ IsMobile and not IsTablet }}",
        newLabel: "{{ translate('New') }}",
        updatedLabel: "{{ translate('Updated') }}",
        isReservable: 1,
        autocompleteUrl: "{{ Path|raw }}ajax/autocomplete.php?type={{ constant('AutoCompleteType::User')|raw }}",
        fastReservationLoad: "{{ FastReservationLoad }}",
        resourceMaxConcurrentReservations,
        autoScrollToday: {{ AutoScrollToday|json_encode|raw }},
        altFormatDate: "{{ date_format('schedule_daily') }}",
    };

    const resourceOrder = [];
    let resourceIndex = 0;
    {% for r in Resources %}
        resourceOrder[{{ r.GetId() }}] = resourceIndex++;
    {% endfor %}
    scheduleOpts.resourceOrder = resourceOrder;

    {% if LoadViewOnly %}
        scheduleOpts.reservationUrlTemplate = "view-reservation.php?{{ constant('QueryStringKeys::REFERENCE_NUMBER')|raw }}=[referenceNumber]";
        scheduleOpts.reservationLoadUrl = "{{ Path|raw }}{{ constant('Pages::VIEW_SCHEDULE')|raw }}?{{ constant('QueryStringKeys::DATA_REQUEST')|raw }}=reservations";
        scheduleOpts.isReservable = {% if AllowGuestBooking %}1{% else %}0{% endif %};
    {% endif %}

    $(document).ready(function() {
        const schedule = new Schedule(scheduleOpts, {{ ResourceGroupsAsJson|raw }});
        schedule.init();

    });

    $('#schedules').select2({
        width: 'resolve'
    });
</script>

{% block scripts_after %}

{% endblock %}

{{ control('DatePickerSetupControl', {
    ControlId: 'datepicker',
    AltInput: false,
    Inline: true,
    DefaultDate: FirstDate,
    NumberOfMonths: PopupMonths,
    ShowButtonPanel: 'true',
    OnSelect: 'dpDateChanged',
    FirstDay: FirstWeekday,
}) }}

