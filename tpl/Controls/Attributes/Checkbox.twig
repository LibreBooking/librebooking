<div class="form-group {{ class }}">
    {% if readonly %}
        {% if tooltip is defined and tooltip %}
            <span class="customAttribute readonly">{{ attribute.Label()|escape_once }}{% if attribute.Required() and not searchmode %}
                    <i class="bi bi-asterisk text-danger align-top text-small"></i>
                {% endif %}:</span>
        {% else %}
            <label class="customAttribute fw-bold readonly"
                for="{{ attributeId }}">{{ attribute.Label()|escape_once }}{% if attribute.Required() and not searchmode %}
                    <i class="bi bi-asterisk text-danger align-top text-small"></i>
                {% endif %}</label>
        {% endif %}
        <span
            class="attributeValue {{ class }}">{% if attribute.Value() == '1' %}{{ translate('True') }}{% else %}{{ translate('False') }}{% endif %}</span>
    {% elseif searchmode %}
        <label class="customAttribute fw-bold search" for="{{ attributeId }}">{{ attribute.Label()|escape_once }}</label>
        <select id="{{ attributeId }}" name="{{ attributeName }}" class="customAttribute form-select form-select-sm">
            <option value="">--</option>
            <option value="0" {% if attribute.Value() == '0' %}selected="selected" {% endif %}>{{ translate('No') }}</option>
            <option value="1" {% if attribute.Value() == '1' %}selected="selected" {% endif %}>{{ translate('Yes') }}</option>
        </select>
    {% else %}
        <div class="form-check">
            <input type="checkbox" value="1" id="{{ attributeId }}" name="{{ attributeName }}"
                {% if attribute.Value() == '1' %}checked="checked" {% endif %} class="form-check-input" />
            <label class="customAttribute standard form-check-label fw-bold" for="{{ attributeId }}">{{ attribute.Label()|escape_once }}
                {% if attribute.Required() and not searchmode %}
                    <i class="bi bi-asterisk"></i>
                {% endif %}
            </label>
        </div>
    {% endif %}
</div>
