<div id="calendarSubscription" class="calendar-subscription text-end">
    {% if IsSubscriptionAllowed and IsSubscriptionEnabled %}
        <a id="subscribeToCalendar" class="link-primary" href="{{ SubscriptionUrl }}"
            title="{{ translate('UrlCopiedToClipboard') }}"
            onclick="copyUrlToClipboard('{{ SubscriptionUrl|escape_js|e('html') }}'); return false;">
            <i class="bi bi-calendar-heart me-1"></i>{{ translate('SubscribeToCalendar') }}</a>
    {% endif %}
</div>
