<div id="calendarSubscription" class="calendar-subscription text-end">
    {% if IsSubscriptionAllowed and IsSubscriptionEnabled %}
        <button id="subscribeToCalendar" type="button" class="btn btn-sm btn-link link-primary"
            title="{{ translate('SubscribeToCalendar') }}"
            onclick="copyUrlToClipboard('{{ SubscriptionUrl|escape_js|e('html') }}');">
            <i class="bi bi-calendar-heart me-1"></i>{{ translate('SubscribeToCalendar') }}</button>
    {% endif %}
</div>
