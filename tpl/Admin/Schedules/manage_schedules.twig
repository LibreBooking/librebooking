    <script type="text/javascript">
        function setUpEditables() {
            $.fn.editable.defaults.mode = 'popup';
            $.fn.editable.defaults.toggle = 'manual';
            $.fn.editable.defaults.emptyclass = '';
            $.fn.editable.defaults.params = function(params) {
                params.CSRF_TOKEN = $('#csrf_token').val();
                return params;
            };

            var updateUrl = '{{ server.SCRIPT_NAME }}?action=';

            $('.scheduleName').editable({
                url: updateUrl + '{{ constant('ManageSchedules::ActionRename') }}',
                validate: function(value) {
                    if ($.trim(value) === '') {
                        return "{{ translate('RequiredValue')|escape_js }}";
                    }
                }
            });

            $('.daysVisible').editable({
                url: updateUrl + '{{ constant('ManageSchedules::ActionChangeDaysVisible') }}'
            });

            $('.dayName').editable({
                url: updateUrl + '{{ constant('ManageSchedules::ActionChangeStartDay') }}',
                source: [{
                        value: '{{ constant('Schedule::Today') }}',
                        text: "{{ Today|escape_js }}"
                    }
                    {% for dayIndex, dayName in DayNames %}
                        , {
                            value: {{ dayIndex }},
                            text: "{{ dayName|escape_js }}"
                        }
                    {% endfor %}
                ]
            });

            $('.defaultScheduleStyle').editable({
                url: updateUrl + '{{ constant('ManageSchedules::ActionChangeDefaultStyle') }}',
                source: [
                    {% for styleIndex, styleName in StyleNames %}
                        {
                            value: '{{ styleIndex }}',
                            text: "{{ styleName|escape_js }}"
                        },
                    {% endfor %}
                ]
            });

            $('.scheduleAdmin').editable({
                url: updateUrl + '{{ constant('ManageSchedules::ChangeAdminGroup') }}',
                emptytext: "{{ translate('None')|escape_js }}",
                source: [{
                        value: '0',
                        text: "{{ translate('None')|escape_js }}",
                    }
                    {% if AdminGroups is defined %}
                        {% for group in AdminGroups %}
                            , {
                                value: {{ group.Id() }},
                                text: "{{ group.Name()|escape_js }}"
                            }
                        {% endfor %}
                    {% endif %}
                ]
            });
        }

        $(document).ready(function() {
            setUpEditables();

            var opts = {
                submitUrl: '{{ server.SCRIPT_NAME }}',
                saveRedirect: '{{ server.SCRIPT_NAME }}',
                changeLayoutAction: '{{ constant('ManageSchedules::ActionChangeLayout') }}',
                addAction: '{{ constant('ManageSchedules::ActionAdd') }}',
                peakTimesAction: '{{ constant('ManageSchedules::ActionChangePeakTimes') }}',
                makeDefaultAction: '{{ constant('ManageSchedules::ActionMakeDefault') }}',
                deleteAction: '{{ constant('ManageSchedules::ActionDelete') }}',
                availabilityAction: '{{ constant('ManageSchedules::ActionChangeAvailability') }}',
                enableSubscriptionAction: '{{ constant('ManageSchedules::ActionEnableSubscription') }}',
                disableSubscriptionAction: '{{ constant('ManageSchedules::ActionDisableSubscription') }}',
                switchLayout: '{{ constant('ManageSchedules::ActionSwitchLayoutType') }}',
                addLayoutSlot: '{{ constant('ManageSchedules::ActionAddLayoutSlot') }}',
                updateLayoutSlot: '{{ constant('ManageSchedules::ActionUpdateLayoutSlot') }}',
                deleteLayoutSlot: '{{ constant('ManageSchedules::ActionDeleteLayoutSlot') }}',
                maximumConcurrentAction: '{{ constant('ManageSchedules::ActionChangeMaximumConcurrent') }}',
                maximumResourcesAction: '{{ constant('ManageSchedules::ActionChangeResourcesPerReservation') }}',
                calendarOptions: {
                    buttonText: {
                        today: "{{ translate('Today')|escape_js }}",
                        month: "{{ translate('Month')|escape_js }}",
                        week: "{{ translate('Week')|escape_js }}",
                        day: "{{ translate('Day')|escape_js }}",
                        list: "{{ translate('List')|escape_js }}"
                    },
                    defaultDate: '{{ now().ToTimezone(Timezone).Format('Y-m-d') }}',
                    eventsUrl: '{{ server.SCRIPT_NAME }}'
                }
            };

            var scheduleManagement = new ScheduleManagement(opts);
            scheduleManagement.init();
        });
    </script>

