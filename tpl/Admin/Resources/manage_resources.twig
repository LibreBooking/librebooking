                                                                        class="bi bi-chevron-down"></i>
                                                                </a>
                                                                <div id="customAttributes{{ id }}" class="collapse show">
                                                                    <div>
                                                                        {% for attribute in applicableAttributes %}
                                                                            {{ include('Admin/InlineAttributeEdit.twig', {url: server.SCRIPT_NAME ~ '?action=' ~ constant('ManageResourcesActions::ActionChangeAttribute'), id: id, attribute: attribute, value: resource.GetAttributeValue(attribute.Id())}) }}
                                                                        {% endfor %}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    {% endif %}
                                                    <div class="">
                                                        <div class="fs-6 fw-bold me-2">{{ translate('Public') }}</div>
                                                        <div class="publicSettingsPlaceHolder">
                                                            {{ include('Admin/Resources/manage_resources_public.twig', {resource: resource}) }}
                                                        </div>
                                                        <div class="">
                                                            <a href="{{ server.SCRIPT_NAME }}?action={{ constant('ManageResourcesActions::ActionPrintQR') }}&rid={{ id }}"
                                                                target="_blank" class="link-primary">{{ translate('PrintQRCode') }}
                                                                <i class="bi bi-qr-code"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {{ pagination(PageInfo) }}
        </div>
