{{ include('globalheader.twig', {InlineEdit: true, DataTable: true, Trumbowyg: true}) }}

<div id="page-manage-resources" class="admin-page">
    <div class="clearfix border-bottom mb-3">
        <div class="dropdown admin-header-more float-end">
            <div class="btn-group btn-group-sm" role="group">
                <button href="#" role="button" class="add-link add-resource btn btn-primary">
                    <span class="bi bi-plus-circle-fill icon add"></span>
                    {{ translate('AddResource') }}
                </button>
                <button class="btn btn-primary dropdown-toggle" type="button" id="moreResourceActions"
                    data-bs-toggle="dropdown">
                    {{ translate('MoreResourceActions') }}
                </button>
                <ul class="dropdown-menu" role="menu" aria-labelledby="moreResourceActions">

                    <li role="presentation">
                        <a role="menuitem" href="{{ Path }}admin/manage_resource_groups.php"
                            class="dropdown-item">{{ translate('ManageResourceGroups') }}</a>
                    </li>
                    <li role="presentation">
                        <a role="menuitem" href="{{ Path }}admin/manage_resource_types.php"
                            class="dropdown-item">{{ translate('ManageResourceTypes') }}</a>
                    </li>
                    <li role="presentation">
                        <a role="menuitem" href="{{ Path }}admin/manage_resource_status.php"
                            class="dropdown-item">{{ translate('ManageResourceStatus') }}</a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li role="presentation">
                        <a role="menuitem" href="#" class="import-resources dropdown-item" id="import-resources">
                            <i class="bi bi-box-arrow-in-down"></i>
                            {{ translate('ImportResources') }}
                        </a>
                    </li>
                    <li role="presentation">
                        <a role="menuitem" href="{{ ExportUrl }}" download="{{ ExportUrl }}"
                            class="export-resources dropdown-item" id="export-resources" target="_blank">
                            <i class="bi bi-box-arrow-in-up"></i>
                            {{ translate('ExportResources') }}
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    {% if Resources is defined and Resources|length > 0 %}
                        <li role="presentation">
                            <a role="menuitem" href="#" class="dropdown-item"
                                id="bulkUpdatePromptButton">{{ translate('BulkResourceUpdate') }}</a>
                        </li>
                    {% endif %}
                    {% if Resources is defined and Resources|length > 0 %}
                        <li role="presentation">
                            <a role="menuitem" href="#" class="dropdown-item"
                                id="bulkDeletePromptButton">{{ translate('BulkResourceDelete') }}</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>

        <h1 class="float-start">{{ translate('ManageResources') }}</h1>
    </div>

    <div class="accordion">
        <div class="accordion-item shadow mb-3 panel-default filterTable" id="filter-resources-panel">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed link-primary fw-bold" type="button" data-bs-toggle="collapse"
                    data-bs-target="#filter-resources-content" aria-expanded="false"
                    aria-controls="filter-resources-content">
                    <i class="bi bi-funnel-fill me-1"></i>{{ translate('Filter') }}
                </button>
            </h2>
            <div id="filter-resources-content" class="accordion-collapse collapse">
                <form id="filterForm" class="horizontal-list" role="form" method="get">
                    <div class="accordion-body">
                        <div class="row gy-2 mb-2">
                            {% set groupClass = 'col-12 col-sm-4 col-md-3' %}

                            <div class="form-group {{ groupClass }}">
                                <label for="filterResourceName" class="fw-bold">{{ translate('Resource') }}</label>
                                <div class="position-relative">
                                    <input id="filterResourceName" class="form-control form-control-sm"
                                        {{ formname(key: 'RESOURCE_NAME') }} value="{{ ResourceNameFilter|escape_once }}"
                                        placeholder="{{ translate('Name') }}" />
                                    <span class="searchclear searchclear-label bi bi-x-circle-fill"
                                        ref="filterResourceName"></span>
                                </div>
                            </div>
                            <div class="form-group {{ groupClass }}">
                                <label for="filterScheduleId" class="fw-bold">{{ translate('Schedule') }}</label>
                                <select id="filterScheduleId" {{ formname(key: 'SCHEDULE_ID') }}
                                    class="form-select form-select-sm">
                                    <option value="">{{ translate('AllSchedules') }}</option>
                                    {{ object_html_options(options: AllSchedules, key: 'GetId', label: 'GetName', selected: ScheduleIdFilter) }}
                                </select>
                            </div>

                            <div class="form-group {{ groupClass }}">
                                <label for="filterResourceType" class="fw-bold">{{ translate('ResourceType') }}</label>
                                <select id="filterResourceType" class="form-select form-select-sm"
                                    {{ formname(key: 'RESOURCE_TYPE_ID') }}>
                                    <option value="">{{ translate('AllResourceTypes') }}</option>
                                    {{ object_html_options(options: ResourceTypes, key: 'Id', label: 'Name', selected: ResourceTypeFilter) }}
                                </select>
                            </div>
                            <div class="form-group {{ groupClass }}">
                                <label for="resourceStatusIdFilter"
                                    class="fw-bold">{{ translate('ResourceStatus') }}</label>
                                <div class="d-flex flex-wrap">
                                    <select id="resourceStatusIdFilter" class="form-select form-select-sm inline w-auto"
                                        {{ formname(key: 'RESOURCE_STATUS_ID') }}>
                                        <option value="">{{ translate('AllResourceStatuses') }}</option>
                                        <option value="{{ constant('ResourceStatus::AVAILABLE') }}">{{ translate('Available') }}</option>
                                        <option value="{{ constant('ResourceStatus::UNAVAILABLE') }}">{{ translate('Unavailable') }}
                                        </option>
                                        <option value="{{ constant('ResourceStatus::HIDDEN') }}">{{ translate('Hidden') }}</option>
                                    </select>
                                    <label for="resourceReasonIdFilter"
                                        class="visually-hidden">{{ translate('Reason') }}</label>
                                    <select id="resourceReasonIdFilter" class="form-select form-select-sm w-auto inline"
                                        {{ formname(key: 'RESOURCE_STATUS_REASON_ID') }}>
                                        <option value="">-</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group {{ groupClass }}">
                                <label for="filterCapacity" class="fw-bold">{{ translate('MinimumCapacity') }}</label>
                                <div class="position-relative">
                                    <input type="number" min="0" id="filterCapacity"
                                        class="form-control form-control-sm" {{ formname(key: 'MAX_PARTICIPANTS') }}
                                        value="{{ CapacityFilter }}" placeholder="{{ translate('MinimumCapacity') }}" />
                                    <span class="searchclear searchclear-label bi bi-x-circle-fill me-4"
                                        ref="filterCapacity"></span>
                                </div>
                            </div>
                            <div class="form-group {{ groupClass }}">
                                <label for="filterRequiresApproval"
                                    class="fw-bold">{{ translate('ResourceRequiresApproval') }}</label>
                                <select id="filterRequiresApproval" class="form-select form-select-sm"
                                    {{ formname(key: 'REQUIRES_APPROVAL') }} title="{{ translate('ResourceRequiresApproval') }}">
                                    <option value="">{{ translate('ResourceRequiresApproval') }}</option>
                                    {{ html_options(options: YesNoOptions, selected: RequiresApprovalFilter) }}
                                </select>
                            </div>
                            <div class="form-group {{ groupClass }}">
                                <label for="filterAutoAssign"
                                    class="fw-bold">{{ translate('ResourcePermissionAutoGranted') }}</label>
                                <select id="filterAutoAssign" class="form-select form-select-sm"
                                    {{ formname(key: 'AUTO_ASSIGN') }} title="{{ translate('ResourcePermissionAutoGranted') }}">
                                    <option value="">{{ translate('ResourcePermissionAutoGranted') }}</option>
                                    {{ html_options(options: YesNoOptions, selected: AutoPermissionFilter) }}
                                </select>
                            </div>
                            <div class="form-group {{ groupClass }}">
                                <label for="filterAllowMultiDay"
                                    class="fw-bold">{{ translate('ResourceAllowMultiDay') }}</label>
                                <select id="filterAllowMultiDay" class="form-select form-select-sm"
                                    {{ formname(key: 'ALLOW_MULTIDAY') }} title="{{ translate('ResourceAllowMultiDay') }}">
                                    <option value="">{{ translate('ResourceAllowMultiDay') }}</option>
                                    {{ html_options(options: YesNoOptions, selected: AllowMultiDayFilter) }}
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            {% for attribute in AttributeFilters %}
                                {{ control('AttributeControl', {idPrefix: 'search', attribute: attribute, searchmode: true, class: 'customAttribute filter-customAttribute' ~ attribute.Id() ~ ' ' ~ groupClass}) }}
                            {% endfor %}
                        </div>

                        <div class="card-footer border-top pt-3">
                            {{ filter_button(attributes: {id: 'filter'}) }}
                            {{ reset_button(attributes: {id: 'clearFilter'}) }}
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="globalError" class="error d-none"></div>

    <div class="card shadow panel-default admin-panel" id="list-resources-panel">
        <div class="no-padding card-body accordion" id="resourceList">
            {% set tableId = 'resourcesTable' %}
            <table class="table table-borderless w-100" id="{{ tableId }}">
                <thead class="d-none">
                    <tr>
                        <th>{{ translate('Resources') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for resource in Resources %}
                        {% set id = resource.GetResourceId() %}
                        <tr>
                            <td>
                                <div class="resourceItem accordion-item shadow mb-2">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                            data-bs-target="#id{{ resource.GetResourceId() }}" aria-expanded="false"
                                            aria-controls="id{{ resource.GetResourceId() }}">
                                            {{ resource.GetName()|escape_once }}
                                        </button>
                                    </h2>

                                    <div id="id{{ id }}" class="accordion-collapse collapse">
                                        <div class="accordion-body resourceDetails" data-resourceId="{{ id }}">
                                            <input type="hidden" class="id" value="{{ id }}" />
                                            <div class="row">
                                                <div class="col-12 col-sm-2 p-2">
                                                    <div class="resourceImage">
                                                        {% if resource.HasImage() %}
                                                            <div id="resourceImageCarousel{{ id }}" class="carousel slide">
                                                                <div
                                                                    class="carousel-inner h-100 ratio ratio-1x1 border rounded-3 shadow-sm">
                                                                    <div class="carousel-item active">
                                                                        <img src="{{ resource_image(resource.GetImage()) }}"
                                                                            alt="{{ resource.GetName()|escape_once }}"
                                                                            class="rounded d-block w-100 h-100 object-fit-cover" />
                                                                    </div>
                                                                    {% for image in resource.GetImages() %}
                                                                        <div class="carousel-item">
                                                                            <img src="{{ resource_image(image) }}"
                                                                                alt="{{ resource.GetName()|escape_once }}"
                                                                                class="rounded d-block w-100 h-100 object-fit-cover" />
                                                                        </div>
                                                                    {% endfor %}
                                                                </div>
                                                                <div class="carousel-indicators mb-0">
                                                                    {% if resource.GetImages()|length > 0 %}
                                                                            <button type="button"
                                                                            data-bs-target="#resourceImageCarousel{{ id }}"
                                                                            data-bs-slide-to="0" class="active"></button>
                                                                        {% for image in resource.GetImages() %}
                                                                            <button type="button"
                                                                                data-bs-target="#resourceImageCarousel{{ id }}"
                                                                                data-bs-slide-to="{{ loop.index }}"></button>
                                                                        {% endfor %}
                                                                    {% endif %}

                                                                </div>
                                                            </div>
                                                        {% else %}
                                                            <div class="noImageContainer text-center">
                                                                <div
                                                                    class="noImage d-flex align-items-center justify-content-center w-100 bg-light border rounded-3 mx-auto">
                                                                    <span class="bi bi-image fs-1"></span>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        <div class="edit-image d-inline-block rounded p-2 bg-body"
                                                            style="position: relative; top: -36px; left:1px; width: 35px; height: 35px;">
                                                            <a href="#" class="update imageButton link-primary "
                                                                title="{{ translate('Change') }}"><span
                                                                    class="bi bi-pencil-square"></span></a>
                                                        </div>
                                                    </div>
                                                    <div class="text-center">
                                                        <div>{{ translate('ResourceColor') }}</div>
                                                        <input type="color"
                                                            class="resourceColorPicker w-50 mx-auto border form-control form-control-color"
                                                            value="{% if resource.HasColor() %}{{ resource.GetColor() }}{% else %}#ffffff{% endif %}"
                                                            alt="{{ translate('ResourceColor') }}"
                                                            title="{{ translate('ResourceColor') }}" />
                                                        <div>
                                                            <a href="#" class="update clearColor link-danger"
                                                                title="{{ translate('Remove') }}"><i
                                                                    class="bi bi-trash3-fill icon delete"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-12 col-sm-10">
                                                    <div class="row row-cols-auto row-cols-sm-3 ">
                                                        <div class="col d-block">
                                                            <div>
                                                                <div class="resourceNameField title fs-5 fw-bold me-1"
                                                                    data-type="text" data-pk="{{ id }}"
                                                                    data-name="{{ constant('FormKeys::RESOURCE_NAME') }}">
                                                                    {{ resource.GetName()|escape_once }}</div>
                                                                <div>
                                                                    <a class="update renameButton link-primary me-1"
                                                                        href="#" title="{{ translate('Rename') }}">
                                                                        <span
                                                                            class="visually-hidden">{{ translate('Rename') }}</span>
                                                                        <i class="bi bi-pencil-square me-1"></i></a>
                                                                    <div class="vr me-1"></div>
                                                                    <a class="update copyButton link-primary me-1" href="#"
                                                                        title="{{ translate('Copy') }}">
                                                                        <span
                                                                            class="visually-hidden">{{ translate('Copy') }}</span>
                                                                        <i class="bi bi-copy"></i></a>
                                                                    <div class="vr me-1"></div>
                                                                    <a class="update deleteButton link-danger me-1" href="#"
                                                                        title="{{ translate('Delete') }}">
                                                                        <span
                                                                            class="visually-hidden">{{ translate('Delete') }}</span>
                                                                        <i class="bi bi-trash3-fill icon delete"></i>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <label class="inline fw-bold">ResourceId:</label>
                                                                <span>{{ id }}</span>
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('Status') }}</label>
                                                                {% if resource.IsAvailable() %}
                                                                    <a class="update changeStatus link-primary" href="#"
                                                                        data-popover-content="#statusDialog">{{ translate('Available') }}</a>
                                                                    <i class="bi bi-check-circle-fill text-success"></i>
                                                                {% elseif resource.IsUnavailable() %}
                                                                    <a class="update changeStatus link-primary" href="#"
                                                                        data-popover-content="#statusDialog">{{ translate('Unavailable') }}</a>
                                                                    <i class="bi bi-exclamation-circle-fill text-warning"></i>
                                                                {% else %}
                                                                    <a class="update changeStatus link-primary" href="#"
                                                                        data-popover-content="#statusDialog">{{ translate('Hidden') }}</a>
                                                                    <i class="bi bi-x-circle-fill text-danger"></i>
                                                                {% endif %}
                                                                {% if resource.GetStatusReasonId() in StatusReasons|keys %}
                                                                    <span
                                                                        class="statusReason">{{ StatusReasons[resource.GetStatusReasonId()].Description()|escape_once }}</span>
                                                                {% endif %}
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('Schedule') }}</label>
                                                                <span class="propertyValue scheduleName" data-type="select"
                                                                    data-pk="{{ id }}"
                                                                    data-value="{{ resource.GetScheduleId() }}"
                                                                    data-name="{{ constant('FormKeys::SCHEDULE_ID') }}">{{ Schedules[resource.GetScheduleId()]|escape_once }}</span>
                                                                <a class="update changeScheduleButton link-primary"
                                                                    title="{{ translate('Edit') }}" href="#"><span
                                                                        class="bi bi-pencil-square"></span></a>
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('ResourceType') }}</label>
                                                                <span class="propertyValue resourceTypeName"
                                                                    data-type="select" data-pk="{{ id }}"
                                                                    data-value="{{ resource.GetResourceTypeId() }}"
                                                                    data-name="{{ constant('FormKeys::RESOURCE_TYPE_ID') }}">
                                                                    {% if resource.HasResourceType() %}
                                                                        {{ ResourceTypes[resource.GetResourceTypeId()].Name()|escape_once }}
                                                                    {% else %}
                                                                        {{ translate('NoResourceTypeLabel') }}
                                                                    {% endif %}
                                                                </span>
                                                                <a class="update changeResourceType link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('ResourceType') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('SortOrder') }}</label>
                                                                <span class="propertyValue sortOrderValue"
                                                                    data-type="number" data-pk="{{ id }}"
                                                                    data-name="{{ constant('FormKeys::RESOURCE_SORT_ORDER') }}">
                                                                    {{ resource.GetSortOrder()|default('0') }}
                                                                </span>
                                                                <a class="update changeSortOrder link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('SortOrder') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>
                                                            </div>
                                                            <div class="mt-2">
                                                                <label
                                                                    class="inline fw-bold">{{ translate('Location') }}</label>
                                                                <span class="propertyValue locationValue" data-type="text"
                                                                    data-pk="{{ id }}" data-value="{{ resource.GetLocation()|escape_once }}"
                                                                    data-name="{{ constant('FormKeys::RESOURCE_LOCATION') }}">
                                                                    {% if resource.HasLocation() %}
                                                                        {{ resource.GetLocation()|escape_once }}
                                                                    {% else %}
                                                                        {{ translate('NoLocationLabel') }}
                                                                    {% endif %}
                                                                </span>
                                                                <a class="update changeLocation link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Location') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('Contact') }}</label>
                                                                <span class="propertyValue contactValue" data-type="{% if ResourceContactIsUser %}select{% else %}text{% endif %}" data-pk="{{ id }}"
                                                                    data-value="{{ resource.GetContact()|escape_once }}"
                                                                    data-name="{{ constant('FormKeys::RESOURCE_CONTACT') }}">
                                                                    {% if resource.HasContact() %}
                                                                        {{ resource.GetContact()|escape_once }}
                                                                    {% else %}
                                                                        {{ translate('NoContactLabel') }}
                                                                    {% endif %}
                                                                </span>
                                                                <a class="update changeContact link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Contact') }}</span>
                                                                    <span class="bi bi-pencil-square"></span></a>
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('Description') }}</label>
                                                                <a class="update changeDescription link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Description') }}</span>
                                                                    <span class="bi bi-pencil-square"></span></a>
                                                                {% if resource.HasDescription() %}
                                                                    {% set description = resource.GetDescription() %}
                                                                {% else %}
                                                                    {% set description = '' %}
                                                                {% endif %}
                                                                <div class="descriptionValue" data-type="trumbowyg" data-pk="{{ id }}" data-value="{{ description|escape_once }}" data-name="{{ constant('FormKeys::RESOURCE_DESCRIPTION') }}">{% if resource.HasDescription() %}{{ description|sanitize_rich_text }}{% else %}{{ translate('NoDescriptionLabel') }}{% endif %}</div>
                                                            </div>
                                                            <div>
                                                                <label
                                                                    class="inline fw-bold">{{ translate('Notes') }}</label>
                                                                <a class="update changeNotes link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Notes') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>
                                                                {% if resource.HasNotes() %}
                                                                    {% set notes = resource.GetNotes() %}
                                                                {% else %}
                                                                    {% set notes = '' %}
                                                                {% endif %}
                                                                <div class="notesValue" data-type="trumbowyg" data-pk="{{ id }}" data-value="{{ notes|escape_once }}" data-name="{{ constant('FormKeys::RESOURCE_NOTES') }}">{% if resource.HasNotes() %}{{ notes|sanitize_rich_text }}{% else %}{{ translate('NoNotesLabel') }}{% endif %}</div>
                                                            </div>
                                                        </div>
                                                        <div class="col">
                                                            <div class="">
                                                                <span class="fs-6 fw-bold">{{ translate('Access') }}</span>
                                                                <a class="inline update changeAccess link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Access') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>

                                                                <div class="accessPlaceHolder">
                                                                    {{ include('Admin/Resources/manage_resources_access.twig', {resource: resource}) }}
                                                                </div>
                                                            </div>
                                                            <div class="mt-2">
                                                                <span
                                                                    class="fs-6 fw-bold">{{ translate('ResourceAdministrator') }}</span>
                                                                {% if AdminGroups|default([])|length > 0 %}
                                                                    <a class="update changeResourceAdmin link-primary"
                                                                        title="{{ translate('Edit') }}" href="#">
                                                                        <span
                                                                            class="visually-hidden">{{ translate('ResourceAdministrator') }}</span>
                                                                        <span class="bi bi-pencil-square"></span></a>
                                                                {% endif %}
                                                                <div>
                                                                    <span class="propertyValue resourceAdminValue"
                                                                        data-type="select" data-pk="{{ id }}"
                                                                        data-value="{{ resource.GetAdminGroupId() }}"
                                                                         data-name="{{ constant('FormKeys::RESOURCE_ADMIN_GROUP_ID') }}">
                                                                            {% set adminGroupId = resource.GetAdminGroupId() %}
                                                                            {% if adminGroupId is not null and adminGroupId in GroupLookup|keys %}
                                                                                {{ GroupLookup[adminGroupId].Name|escape_once }}
                                                                            {% else %}
                                                                                {{ translate('None') }}
                                                                            {% endif %}
                                                                        </span>
                                                                </div>
                                                            </div>
                                                            <div class="mt-2">
                                                                <span
                                                                    class="fs-6 fw-bold">{{ translate('Permissions') }}</span>
                                                                <div>
                                                                    <a href="#"
                                                                        class="update changeUserPermission link-primary">{{ translate('Users') }}</a>
                                                                    <div class="vr mx-1"></div>
                                                                    <a href="#"
                                                                        class="update changeGroupPermissions link-primary">{{ translate('Groups') }}</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col">
                                                            <div class="">
                                                                <span class="fs-6 fw-bold">{{ translate('Duration') }}</span>
                                                                <a class="inline update changeDuration link-primary"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Duration') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>

                                                                <div class="durationPlaceHolder">
                                                                    {{ include('Admin/Resources/manage_resources_duration.twig', {resource: resource}) }}
                                                                </div>
                                                            </div>

                                                            {% if CreditsEnabled %}
                                                                <div class="mt-2">
                                                                    <span class="fs-6 fw-bold">{{ translate('Credits') }}</span>
                                                                    <a class="inline update changeCredits link-primary"
                                                                        title="{{ translate('Edit') }}" href="#">
                                                                        <span
                                                                            class="visually-hidden">{{ translate('Credits') }}</span>
                                                                        <span class="bi bi-pencil-square"></span>
                                                                    </a>
                                                                    <div class="creditsPlaceHolder">
                                                                        {{ include('Admin/Resources/manage_resources_credits.twig', {resource: resource}) }}
                                                                    </div>
                                                                </div>
                                                            {% endif %}

                                                            <div class="mt-2">
                                                                <span class="fs-6 fw-bold">{{ translate('Capacity') }}</span>
                                                                <a class="link-primary update changeCapacity"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('Capacity') }}</span>
                                                                    <span class="bi bi-pencil-square"></span>
                                                                </a>
                                                                <div class="capacityPlaceHolder">
                                                                    {{ include('Admin/Resources/manage_resources_capacity.twig', {resource: resource}) }}
                                                                </div>
                                                            </div>
                                                            <div class="mt-2">
                                                                <span
                                                                    class="fs-6 fw-bold">{{ translate('ResourceGroups') }}</span>
                                                                <a class="link-primary update changeResourceGroups"
                                                                    title="{{ translate('Edit') }}" href="#">
                                                                    <span
                                                                        class="visually-hidden">{{ translate('ResourceGroups') }}</span>
