                                                        {% if applicableAttributes|length > 0 %}
                                                            <div class="mb-4">
                                                                <span class="fs-6 fw-bold">{{ translate('CustomAttributes') }}</span>
                                                                <a id="customAttributesControl" class="link-primary" href="#"
