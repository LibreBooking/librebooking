<h5 class="mt-2">
    <span id="totalGroups">{{ Groups|default([])|length }}</span> {{ translate('Groups') }} <span
        class="d-none group-permission-spinner">
        <div class="spinner-border spinner-border-sm" role="status"></div>
    </span>
</h5>
<table class="table table-striped">
    <tbody>
        {% for g in Groups|default([]) %}
            <tr>
                <td>
                    <div class="form-group clearfix">
                        <label for="permission{{ g.Id }}" class="float-start">{{ g.Name|escape_once }}</label>
                        <select class="change-permission-type float-end form-select form-select-sm inline-block"
                            style="width:auto;" id="permission{{ g.Id }}" data-group-id="{{ g.Id }}">
                            <option value="{{ constant('ResourcePermissionType::None') }}" class="none"
                                {% if g.PermissionType == constant('ResourcePermissionType::None') %}selected="selected" {% endif %}>
                                {{ translate('None') }}
                            </option>
                            <option value="{{ constant('ResourcePermissionType::Full') }}" class="full"
                                {% if g.PermissionType == constant('ResourcePermissionType::Full') %}selected="selected" {% endif %}>
                                {{ translate('FullAccess') }}
                            </option>
                            <option value="{{ constant('ResourcePermissionType::View') }}" class="view"
                                {% if g.PermissionType == constant('ResourcePermissionType::View') %}selected="selected" {% endif %}>
                                {{ translate('ViewOnly') }}
                            </option>
                        </select>
                        <input type="hidden" class="id" value="{{ g.Id }}" />
                    </div>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
