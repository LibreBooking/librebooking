{{ vendor_js('jqtree/1.8.11/js/tree.jquery.js') }}
{{ vendor_js('jquery-cookie/1.3.1/js/jquery.cookie.js') }}
{{ vendor_js('jquery-contextmenu/2.9.2/js/jquery.contextMenu.js') }}

<script type="text/javascript">
    $(document).ready(function() {
        var actions = {
            addResource: '{{ constant('ManageResourceGroupsActions::AddResource') }}',
            removeResource: '{{ constant('ManageResourceGroupsActions::RemoveResource') }}',
            moveNode: '{{ constant('ManageResourceGroupsActions::MoveNode') }}'
        };

        var groupOptions = {
            submitUrl: '{{ server.SCRIPT_NAME }}',
            actions: actions,
            renameText: '{{ translate('Rename')|escape_js }}',
            addChildText: '{{ translate('AddGroup')|escape_js }}',
            deleteText: '{{ translate('Delete')|escape_js }}',
            exitText: '{{ translate('Close')|escape_js }}'
        };

        var groupManagement = new ResourceGroupManagement(groupOptions);
        groupManagement.init({{ ResourceGroups|raw }});

        $('#help-button').click(function(e) {
            $('#' + $(this).attr('help-ref')).dialog();
        });
    });
</script>
</div>

{{ include('globalfooter.twig') }}
