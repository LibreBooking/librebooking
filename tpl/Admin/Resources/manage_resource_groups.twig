{{ include('globalheader.twig', {cssFiles: 'assets/vendor/jquery-contextmenu/2.9.2/css/jquery.contextMenu.css,assets/vendor/jqtree/1.8.11/css/jqtree.css'}) }}

<div id="page-manage-resource-groups" class="admin-page">

    {{ include('Admin/Resources/manage_resource_menu.twig', {ResourcePageTitleKey: 'ManageResourceGroups'}) }}

    <div id="globalError" class="alert alert-danger d-none"></div>

    <div id="manage-resource-groups-container bg-dark">
        <div class="card shadow mb-3">
            <div class="card-body">
                <div id="help" class="alert alert-info d-flex align-items-center" role="alert">
                    <div>
                        <div>{{ translate('ResourceGroupHelp1') }}</div>
                        <div>{{ translate('ResourceGroupHelp2') }}</div>
                        <div>{{ translate('ResourceGroupHelp3') }}</div>
                    </div>
                    <div class="ms-auto">
                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                            aria-label="{{ translate('Close') }}">
                        </button>
                    </div>
                </div>
                <div id="new-group">
                    <form method="post" id="addGroupForm" ajaxAction="{{ constant('ManageResourceGroupsActions::AddGroup') }}">
                        <div class="row">
                            <div class="form-group col-sm-6 mx-auto">
                                <label for="groupName" class="visually-hidden">{{ translate('AddNewGroup') }}</label>
                                <div class="input-group mb-3">
                                    <input type="text" name="{{ constant('FormKeys::GROUP_NAME') }}"
                                        class="form-control form-control-sm new-group inline" size="30" id="groupName"
                                        placeholder="{{ translate('AddNewGroup') }}" />
                                    <input type="hidden" name="{{ constant('FormKeys::PARENT_ID') }}" />
                                    <button type="button" class="btn btn-primary btn-sm" id="btnAddGroup">
                                        <i class="bi bi-plus-circle-fill icon add inline"></i>
                                        {{ translate('Add') }}</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="d-flex justify-content-center gap-5">
                    <div id="group-tree"></div>
                    <div id="resource-list">
                        <div class="fs-4">{{ translate('Resources') }}</div>
                        {% for resource in Resources %}
                            <div class="resource-draggable" resource-name="{{ resource.GetName()|escape_once }}"
                                resource-id="{{ resource.GetId() }}">{{ resource.GetName()|escape_once }}</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="activeId" value="" />

<div id="renameDialog" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="renameGroupDialogLabel"
    aria-hidden="true">
    <form id="renameForm" method="post" ajaxAction="{{ constant('ManageResourceGroupsActions::RenameGroup') }}" class="was-validated">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="renameGroupDialogLabel">{{ translate('Rename') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label fw-bold" for="editName">{{ translate('Name') }}</label>
                        <input id="editName" type="text" class="form-control textbox required triggerSubmit" required
                            maxlength="85" {{ formname(key: 'GROUP_NAME') }} />
                    </div>
                </div>
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            </div>
        </div>
    </form>
</div>

<div id="deleteDialog" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteDialogLabel"
    aria-hidden="true">
    <form id="deleteForm" method="post" ajaxAction="{{ constant('ManageResourceGroupsActions::DeleteGroup') }}">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <div>{{ translate('DeleteWarning') }}</div>
                    </div>
                </div>
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button() }}
                    {{ indicator() }}
                </div>
            </div>
        </div>
    </form>
</div>

<div id="addChildDialog" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="addGroupDialogLabel"
    aria-hidden="true">
    <form id="addChildForm" method="post" ajaxAction="{{ constant('ManageResourceGroupsActions::AddGroup') }}" class="was-validated">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addGroupDialogLabel">{{ translate('AddNewGroup') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="childName" class="form-label fw-bold">{{ translate('Name') }}</label>
                        <input id="childName" type="text" class="form-control required new-group" maxlength="85"
                            {{ formname(key: 'GROUP_NAME') }} required />
                    </div>
                </div>
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ add_button() }}
                    <input type="hidden" id="groupParentId" name="{{ constant('FormKeys::PARENT_ID') }}" />

                    {{ indicator() }}
                </div>
            </div>
        </div>
    </form>
</div>

{{ csrf_token() }}

