{{ include('globalheader.twig') }}

<div id="page-manage-email-templates" class="admin-page">

    <div class="card shadow col-12 col-sm-8 mx-auto">
        <div class="card-body row">
            <h1 class="border-bottom mb-3">{{ translate('ManageEmailTemplates') }}</h1>

            <div class="form-group col-sm-8 col-6 mb-3">
                <select id="templateOpts" title="{{ translate('EmailTemplate') }}" class="form-select form-select-sm">
                    <option value="">--- {{ translate('SelectEmailTemplate') }} ---</option>
                    {% for template in Templates %}
                        <option value="{{ template.FileName() }}">{{ template.Name() }}</option>
                    {% endfor %}
                </select>

            </div>

            <div class="form-group col-sm-4 col-6">
                <select id="languageOpts" title="{{ translate('Language') }}" class="form-select form-select-sm">
                    {% for language in Languages %}
                        <option value="{{ language.LanguageCode }}" {% if Language == language.LanguageCode %}selected="selected"
                            {% endif %}>{{ language.DisplayName }}</option>
                    {% endfor %}
                </select>
            </div>

            <div id="editEmailSection" class="d-none">
                <div class="mb-2">
                    <form role="form" id="updateEmailForm" ajaxAction="{{ constant('EmailTemplatesActions::Update') }}" method="post">
                        <div class="form-group">
                            <textarea id="templateContents" {{ formname('EMAIL_CONTENTS') }}
                                title="{{ translate('EmailTemplate') }}" class="form-control mb-2" rows="20"
                                style="width:100%"></textarea>
                        </div>

                        <div class="form-group">
                            {{ indicator() }}
                            {{ update_button(submit: true) }}
                            <input id="reloadEmailContents" type="button" class="btn btn-outline-secondary btn-sm"
                                value="{{ translate('ReloadOriginalContents') }}" />
                        </div>

                        <input type="hidden" id="templatePath" {{ formname('EMAIL_TEMPLATE_NAME') }} />
                        <input type="hidden" id="selectedLanguage" {{ formname('EMAIL_TEMPLATE_LANGUAGE') }} />
                        {{ csrf_token() }}
                    </form>
                </div>

                <div id="updateSuccess" class="alert alert-success d-none">
                    <i class="bi bi-check-circle me-1"></i> {{ translate('UpdateEmailTemplateSuccess') }}
                </div>

                <div id="updateFailed" class="alert alert-warning d-none">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>{{ translate('UpdateEmailTemplateFailure') }}
                </div>
            </div>

            {{ include('javascript-includes.twig') }}

            {{ jsfile(src: 'ajax-helpers.js') }}
            {{ jsfile(src: 'admin/email-templates.js') }}
            <script type="text/javascript">
                $(document).ready(function() {
                    var opts = {
                        scriptUrl: '{{ server.SCRIPT_NAME|raw }}' {# raw: JS string context #}
                    };
                    var emails = new EmailTemplateManagement(opts);
                    emails.init();
                });
            </script>
            <div id="wait-box" class="wait-box">
                {{ include('wait-box.twig', {translateKey: 'Working'}) }}
            </div>
        </div>
    </div>
</div>

{{ include('globalfooter.twig') }}
