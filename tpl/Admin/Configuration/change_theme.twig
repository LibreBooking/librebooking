{{ include('globalheader.twig') }}

<div id="page-change-theme" class="admin-page">
    <div class="card shadow col-12 col-sm-8 mx-auto">
        <div class="card-body">
            <h1 class="border-bottom mb-3">{{ translate('LookAndFeel') }}</h1>

            <div id="successMessage" class="alert alert-success d-none">
                {{ translate('ThemeUploadSuccess') }}
            </div>

            <form id="elementForm" action="{{ server.SCRIPT_NAME }}" ajaxAction="update" method="post"
                enctype="multipart/form-data">
                <div class="validationSummary alert alert-danger d-none" id="validationErrors">
                    <ul>
                        {{ async_validator('logoFileExt') }}
                        {{ async_validator('cssFileExt') }}
                        {{ async_validator('faviconFileExt') }}
                        {{ async_validator('logoFile') }}
                        {{ async_validator('cssFile') }}
                        {{ async_validator('faviconFile') }}
                    </ul>
                </div>

                <ul class="list-group mb-2">

                    <li class="list-group-item">
                        <div class="fs-4">{{ translate('Logo') }} (*.png, *.gif, *.jpg - Recommended height 75px)</div>
                        <img src="{{ ScriptUrl }}/{{ LogoUrl }}" class="d-block mx-auto mw-100"
                            alt="{{ translate('Logo') }}" />
                        <div class="d-flex align-items-center justify-content-center my-2">
                            <a href="{{ ScriptUrl }}/{{ LogoUrl }}" download="{{ LogoUrl }}"
                                class="link-primary"><i class="bi bi-download me-1"></i>{{ LogoUrl }}</a>
                            <div class="vr mx-1"></div>
                            <a href="#" id="removeLogo" class="link-danger text-decoration-none"><i
                                    class="bi bi-trash3-fill me-1"></i>{{ translate('Remove') }}</a>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="file" {{ formname('LOGO_FILE') }} class="form-control" id="logoFile"
                                accept=".png, .gif, .jpg, .jpeg" aria-label="{{ translate('Logo') }}" />
                            <a href="#" class="clearInput inline input-group-text"><span
                                    class="visually-hidden">{{ translate('Delete') }}</span><i
                                    class="bi bi-x-square-fill text-danger"></i></a>
                        </div>
                    </li>

                    <li class="list-group-item">
                        <div class="fs-4">Favicon (*.ico, *.png, *.gif, *.jpg - Recommended size 48px x 48px)</div>
                        <img src="{{ ScriptUrl }}/{{ FaviconUrl }}" class="d-block mx-auto" alt="Favicon" />
                        <div class="d-flex align-items-center justify-content-center my-2">
                            <a href="{{ ScriptUrl }}/{{ FaviconUrl }}" download="{{ FaviconUrl }}"
                                class="link-primary"><i class="bi bi-download me-1"></i>{{ FaviconUrl }}</a>
                            <div class="vr mx-1"></div>
                            <a href="#" id="removeFavicon" class="link-danger text-decoration-none"><i
                                    class="bi bi-trash3-fill me-1"></i>{{ translate('Remove') }}</a>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="file" {{ formname('FAVICON_FILE') }} class="form-control" id="faviconFile"
                                accept=".png, .gif, .jpg, .jpeg, .ico" aria-label="Favicon" />
                            <a href="#" class="clearInput inline input-group-text"><span
                                    class="visually-hidden">{{ translate('Delete') }}</span><i
                                    class="bi bi-x-square-fill text-danger"></i></a>
                        </div>
                    </li>

                    <li class="list-group-item">
                        <div>
                            <div class="fs-4">{{ translate('CssFile') }} (*.css)</div>
                            <div class="d-flex align-items-center justify-content-center my-2">
                                <a href="{{ ScriptUrl }}/css/{{ CssUrl }}" download="{{ ScriptUrl }}/css/{{ CssUrl }}"
                                    class="link-primary"><i class="bi bi-download me-1"></i>{{ CssUrl }}</a>
                                <div class="vr mx-1"></div>
                                <a href="#" id="removeCss" class="link-danger text-decoration-none"><i
                                        class="bi bi-trash3-fill me-1"></i>{{ translate('Remove') }}</a>
                            </div>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="file" {{ formname('CSS_FILE') }} class="form-control" id="cssFile" accept=".css"
                                aria-label="{{ translate('CssFile') }}" />
                            <a href="#" class="clearInput input-group-text"><span
                                    class="visually-hidden">{{ translate('Delete') }}</span><i
                                    class="bi bi-x-square-fill text-danger"></i></a>
                        </div>
                    </li>

                </ul>

                <div class="d-grid">
                    <button type="button" class="btn btn-primary btn-sm update" name="{{ constant('Actions::SAVE') }}" id="saveButton">
                        {{ translate('Update') }}
                    </button>
                </div>

                {{ csrf_token() }}

            </form>
        </div>
    </div>

    <div class="modal" id="waitModal" tabindex="-1" role="dialog" aria-labelledby="waitModalLabel"
        data-bs-backdrop="static" aria-hidden="true">
        {{ include('wait-box.twig', {translateKey: 'Working'}) }}
    </div>

    {{ include('javascript-includes.twig') }}

    {{ jsfile(src: 'ajax-helpers.js') }}
    {{ vendor_js(src: 'jquery-form/3.09/jquery.form-3.09.min.js') }}
    {{ vendor_js(src: 'ajaxfileupload/1.0.0/js/ajaxfileupload.js') }}
    {{ jsfile(src: 'ajax-form-submit.js') }}

    <script type="text/javascript">
        $('document').ready(function() {

            $('#elementForm').bindAjaxSubmit($('#saveButton'), $('#successMessage'), $('#wait-box'));

            $('.clearInput').click(function(e) {
                e.preventDefault();
                $(this).prev('input').val('');
            });

            $('#removeLogo').click(function(e) {
                e.preventDefault();

                PerformAsyncAction($(this), function() {
                    return '{{ server.SCRIPT_NAME|raw }}?action=removeLogo'; {# raw: JS string context #}
                });
            });

            $('#removeFavicon').click(function(e) {
                e.preventDefault();

                PerformAsyncAction($(this), function() {
                    return '{{ server.SCRIPT_NAME|raw }}?action=removeFavicon'; {# raw: JS string context #}
                });
            });

            $('#removeCss').click(function(e) {
                e.preventDefault();

                PerformAsyncAction($(this), function() {
                    return '{{ server.SCRIPT_NAME|raw }}?action=removeCss'; {# raw: JS string context #}
                });
            });
        });
    </script>

</div>
{{ include('globalfooter.twig') }}
