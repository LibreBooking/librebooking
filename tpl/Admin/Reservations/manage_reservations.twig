        function setUpPopovers() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        function setUpEditables() {
            $.fn.editable.defaults.mode = 'popup';
            $.fn.editable.defaults.toggle = 'manual';
            $.fn.editable.defaults.emptyclass = '';
            $.fn.editable.defaults.params = function(params) {
                params.CSRF_TOKEN = $('#csrf_token').val();
                return params;
            };

            var updateUrl = '{{ server.SCRIPT_NAME|raw }}?action='; {# raw: JS string context #}

            $('.inlineAttribute').editable({
                url: updateUrl + '{{ constant('ManageReservationsActions::UpdateAttribute')|raw }}', emptytext: '-' {# raw: JS string context #}
            });
        }

        $(document).ready(function() {

            setUpPopovers();
            //hidePopoversWhenClickAway();
            setUpEditables();
            dropzone($("#termsOfServiceUpload"));

            var updateScope = {};
            updateScope['btnUpdateThisInstance'] = '{{ constant('SeriesUpdateScope::ThisInstance')|raw }}'; {# raw: JS string context #}
            updateScope['btnUpdateAllInstances'] = '{{ constant('SeriesUpdateScope::FullSeries')|raw }}'; {# raw: JS string context #}
            updateScope['btnUpdateFutureInstances'] = '{{ constant('SeriesUpdateScope::FutureInstances')|raw }}'; {# raw: JS string context #}

            var actions = {};

            var resOpts = {
                autocompleteUrl: "{{ Path is defined ? Path : '' }}ajax/autocomplete.php?type={{ constant('AutoCompleteType::User')|raw }}", {# raw: JS string context #}
                reservationUrlTemplate: "{{ Path is defined ? Path : '' }}reservation.php?{{ constant('QueryStringKeys::REFERENCE_NUMBER')|raw }}=[refnum]", {# raw: JS string context #}
                popupUrl: "{{ Path is defined ? Path : '' }}ajax/respopup.php",
                updateScope: updateScope,
                actions: actions,
                deleteUrl: '{{ Path is defined ? Path : '' }}ajax/reservation_delete.php?{{ constant('QueryStringKeys::RESPONSE_TYPE')|raw }}=json', {# raw: JS string context #}
                resourceStatusUrl: '{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACTION')|raw }}=changeStatus', {# raw: JS string context #}
                submitUrl: '{{ server.SCRIPT_NAME|raw }}', {# raw: JS string context #}
                termsOfServiceUrl: '{{ server.SCRIPT_NAME|raw }}?dr=tos', {# raw: JS string context #}
                updateTermsOfServiceAction: 'termsOfService',
                deleteTermsOfServiceAction: 'deleteTerms'
            };

            var approvalOpts = {
                url: '{{ Path is defined ? Path : '' }}ajax/reservation_approve.php'
            };

            var approval = new Approval(approvalOpts);

            var reservationManagement = new ReservationManagement(resOpts, approval);
            reservationManagement.init();

            {% for reservation in reservations %}

                reservationManagement.addReservation({
                    id: '{{ reservation.ReservationId }}',
                    referenceNumber: '{{ reservation.ReferenceNumber }}',
                    isRecurring: '{{ reservation.IsRecurring }}',
                    resourceStatusId: '{{ reservation.ResourceStatusId }}',
                    resourceStatusReasonId: '{{ reservation.ResourceStatusReasonId }}',
                    resourceId: '{{ reservation.ResourceId }}'
                });
            {% endfor %}

            {% for reason in StatusReasons %}
                reservationManagement.addStatusReason('{{ reason.Id() }}', '{{ reason.StatusId() }}', '{{ reason.Description()|escape_js }}');
            {% endfor %}

            reservationManagement.initializeStatusFilter('{{ ResourceStatusFilterId is defined ? ResourceStatusFilterId : '' }}', '{{ ResourceStatusReasonFilterId is defined ? ResourceStatusReasonFilterId : '' }}');
        });
    </script>

