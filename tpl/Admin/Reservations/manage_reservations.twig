                                </div>
                                <input id="tos-upload" type="file" {{ formname(key: 'TOS_UPLOAD') }} accept="application/pdf" />
                            </div>
                            <div id="tos-upload-link" class="d-none">
                                <a href="{{ ScriptUrl is defined ? ScriptUrl : '' }}/uploads/tos/tos.pdf" target="_blank" class="link-primary"><span
                                        class="bi bi-filetype-pdf me-1"></span> {{ translate('ViewTerms') }}
                                </a>
                            </div>
                        </div>
                        <div class="mt-3">
                            <div>{{ translate('RequireTermsOfServiceAcknowledgement') }}</div>
                            <div class="form-check">
                                <input type="radio" {{ formname(key: 'TOS_APPLICABILITY') }} class="form-check-input"
                                    value="{{ constant('TermsOfService::RESERVATION') }}" id="tos_reservation" checked="checked">
                                <label for="tos_reservation"
                                    class="form-check-label">{{ translate('UponReservation') }}</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" {{ formname(key: 'TOS_APPLICABILITY') }} class="form-check-input"
                                    value="{{ constant('TermsOfService::REGISTRATION') }}" id="tos_registration">
                                <label for="tos_registration"
                                    class="form-check-label">{{ translate('UponRegistration') }}</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        {{ cancel_button() }}
                        {{ delete_button(class: 'd-none', attributes: {id: 'deleteTerms'}) }}
