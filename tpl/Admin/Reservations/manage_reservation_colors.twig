{% set DataTable = true %}{{ include('globalheader.twig') }}

<div id="page-manage-reservation-colors" class="admin-page">

    <h1 class="border-bottom mb-3">{{ translate('ReservationColors') }}</h1>
    <div class="card shadow mb-2 default-box">
        <div class="card-body">
            <form class="form-inline" role="form">
                <div class="d-flex align-items-center">
                    <label class="fw-bold" for="attributeOption">{{ translate('Attribute') }}</label>
                    <select class="form-select form-select-sm w-auto mx-2" id="attributeOption">
                        {% for attribute in Attributes %}
                            <option value="{{ attribute.Id() }}">{{ attribute.Label()|escape_once }}</option>
                        {% endfor %}
                    </select>

                    <button type="button" class="btn btn-primary btn-sm" id="addRuleButton">
                        <i class="bi bi-plus-lg"></i> {{ translate('AddRule') }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            {% set tableId = 'reservationColorTable' %}
            <table class="table table-striped table-hover border-top" id="{{ tableId }}">
                <thead>
                    <tr>
                        <th>{{ translate('Attribute') }}</th>
                        <th>{{ translate('RequiredValue') }}</th>
                        <th>{{ translate('Color') }}</th>
                        <th class="action">{{ translate('Delete') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rule in Rules %}
                        <tr>
                            <td>{{ rule.AttributeName|escape_once }}</td>
                            <td>{{ rule.RequiredValue|escape_once }}</td>
                            <td style="background-color:{{ rule.Color }}">&nbsp;</td>
                            <td class="action">
                                <a href="#" class="update delete" ruleId="{{ rule.Id }}" aria-label="{{ translate('Delete') }}">
                                    <span class="bi bi-trash3-fill icon text-danger remove"></span>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addDialog" tabindex="-1" role="dialog" aria-labelledby="addDialogLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="addForm" method="post" action="{{ server.SCRIPT_NAME }}?action=add" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addDialogLabel">{{ translate('AddReservationColorRule') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    {{ translate('ReservationCustomRuleAdd') }}
                    <div class="d-flex align-items-end">
                        <div id="attributeFillIn"></div>
                        <div id="color">
                            <label for="reservationColor" class="visually-hidden">Reservation Color</label>
                            <input type="color" {{ formname(key: 'RESERVATION_COLOR') }}
                                class="form-control form-control-color required" id="reservationColor" maxlength="6" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ add_button() }}
                    {{ indicator() }}
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="deleteDialog" tabindex="-1" role="dialog" aria-labelledby="deleteDialogLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <form id="deleteForm" action="{{ server.SCRIPT_NAME }}?action=delete" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        {{ translate('DeleteWarning') }}
                    </div>
                    <input type="hidden" id="deleteRuleId" {{ formname(key: 'RESERVATION_COLOR_RULE_ID') }} />
                </div>
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button() }}
                    {{ indicator() }}
                </div>
            </div>
        </form>
    </div>
</div>

{% for attribute in Attributes %}
    <div id="attribute{{ attribute.Id() }}" class="d-none">
        {{ control('AttributeControl', {attribute: attribute, searchmode: true}) }}</div>
{% endfor %}

{{ csrf_token() }}

</div>

{{ render_partial('javascript-includes.tpl', _context) }}
{{ datatable(tableId: tableId) }}
{{ jsfile(src: 'ajax-helpers.js') }}
{{ vendor_js(src: 'jquery-form/3.09/jquery.form-3.09.min.js') }}
{{ jsfile(src: 'ajax-form-submit.js') }}
{{ jsfile(src: 'admin/reservation-colors.js') }}

<script type="text/javascript">
    $('document').ready(function() {
        var mgmt = new ReservationColorManagement();
        mgmt.init();
    });
</script>

{{ include('globalfooter.twig') }}
