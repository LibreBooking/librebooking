<div class="table-responsive">
    {% set tableId = 'transaction-log-list' %}
    <table class="table table-striped table-hover border-top w-100" id="{{ tableId }}">
        <thead>
            <tr>
                <th>{{ translate('Date') }}</th>
                <th>{{ translate('User') }}</th>
                <th>{{ translate('Status') }}</th>
                <th>{{ translate('Total') }}</th>
                <th>{{ translate('TransactionFee') }}</th>
                <th>{{ translate('AmountRefunded') }}</th>
                <th>{{ translate('InvoiceNumber') }}</th>
                <th>{{ translate('TransactionId') }}</th>
                <th>{{ translate('Gateway') }}</th>
                <th>{{ translate('Refund') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for log in TransactionLog %}
                <tr>
                    <td data-order="{{ format_date(date: log.TransactionDate, timezone: Timezone, format: 'Y-m-d H:i:s') }}">
                        {{ format_date(date: log.TransactionDate, timezone: Timezone, key: 'general_datetime') }}
                    </td>
                    <td>{{ log.UserFullName|escape_once }}</td>
                    <td>{{ log.Status }}</td>
                    <td>{{ formatcurrency(amount: log.Total, currency: log.Currency) }}</td>
                    <td>{{ formatcurrency(amount: log.Fee, currency: log.Currency) }}</td>
                    <td>{{ formatcurrency(amount: log.AmountRefunded, currency: log.Currency) }}</td>
                    <td>{{ log.InvoiceNumber }}</td>
                    <td>{{ log.TransactionId }}</td>
                    <td>{{ log.GatewayName }}</td>
                    <td>{% if log.Total > 0 and (log.AmountRefunded < log.Total) %}
                            <a href="#" class="refund link-primary" data-id="{{ log.Id }}">{{ translate('IssueRefund') }}</a>
                        {% else %}
                            {{ translate('FullyRefunded') }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ pagination(PageInfo) }}
</div>
{{ datatable(tableId) }}
