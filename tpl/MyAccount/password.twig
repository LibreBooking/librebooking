{{ include('globalheader.twig') }}

<div class="page-change-password">

    {% if not (AllowPasswordChange is defined and AllowPasswordChange) %}
        <div class="alert alert-danger text-center">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i> {{ translate('PasswordControlledExternallyError') }}
        </div>
    {% else %}
        <form id="password-reset-form" method="post" action="{{ server.SCRIPT_NAME }}">
            <div id="password-reset-box" class="default-box card shadow col-12 col-sm-8 mx-auto">
                <div class="card-body">
                    <h1 class="text-center border-bottom mb-2">{{ translate('ChangePassword') }}</h1>

                    {% if ResetPasswordSuccess is defined and ResetPasswordSuccess %}
                        <div class="success alert alert-success">
                            <i class="bi bi-check-circle-fill"></i> {{ translate('PasswordChangedSuccessfully') }}
                        </div>
                    {% endif %}

                    {% set _vg %}
                    {{ validator(id: 'currentpassword', key: 'InvalidPassword') }}
                    {{ validator(id: 'passwordmatch', key: 'PwMustMatch') }}
                    {{ validator(id: 'passwordcomplexity', key: '') }}
                    {% endset %}
                    {{ validation_group(_vg, 'alert alert-danger') }}
                    <div class="form-group mb-2">
                        <label class="fw-bold" for="{{ constant('FormKeys::CURRENT_PASSWORD') }}">{{ translate('CurrentPassword') }}</label>
                        {{ textbox(name: 'CURRENT_PASSWORD', type: 'password') }}
                    </div>

                    <div class="form-group mb-2">
                        <label class="fw-bold" for="{{ constant('FormKeys::PASSWORD') }}">{{ translate('NewPassword') }}</label>
                        {{ textbox(name: 'PASSWORD', type: 'password') }}
                    </div>

                    <div class="form-group mb-3">
                        <label class="fw-bold"
                            for="{{ constant('FormKeys::PASSWORD_CONFIRM') }}">{{ translate('PasswordConfirmation') }}</label>
                        {{ textbox(name: 'PASSWORD_CONFIRM', type: 'password', value: '') }}

                    </div>

                    <div class="form-group d-grid">
                        <button type="submit" name="{{ constant('Actions::CHANGE_PASSWORD') }}" value="{{ translate('ChangePassword') }}"
                            class="btn btn-primary">{{ translate('ChangePassword') }}</button>
                    </div>
                </div>
                {{ csrf_token() }}
        </form>
    </div>
    {{ setfocus(key: 'CURRENT_PASSWORD') }}
{% endif %}

</div>
{{ include('javascript-includes.twig') }}
{{ include('globalfooter.twig') }}
