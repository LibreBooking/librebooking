{{ include('globalheader.twig') }}

<div class="page-notification-preferences">
    {% if not (EmailEnabled is defined and EmailEnabled) %}
        <div class="alert alert-danger text-center">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i> {{ translate('EmailDisabled') }}
        </div>
    {% else %}
        <div id="notification-preferences-box" class="default-box card shadow col- col-sm-8 mx-auto">

            <form id="notification-preferences-form" method="post" action="{{ server.SCRIPT_NAME }}">
                <div class="card-body mx-3">
                    <h1 class="text-center border-bottom mb-3">{{ translate('NotificationPreferences') }}</h1>
                    {% if PreferencesUpdated is defined and PreferencesUpdated %}
                        <div class="success alert alert-success">
                            <i class="bi bi-check-circle-fill"></i> {{ translate('YourSettingsWereUpdated') }}
                        </div>
                    {% endif %}
                    <div class="row gy-3">
                        <div class="notification-row col-12 col-sm-6">
                            <div class="notification-type">{{ translate('ReservationCreatedPreference') }}</div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="{{ constant('ReservationEvent::Created') }}" name="{{ constant('ReservationEvent::Created') }}"
                                    {% if Created is defined and Created %}checked="checked" {% endif %}>
                                <label class="form-check-label"
                                    for="{{ constant('ReservationEvent::Created') }}">{{ translate('PreferenceSendEmail') }}</label>
                            </div>
                        </div>

                        <div class="notification-row col-12 col-sm-6">
                            <div class="notification-type">{{ translate('ReservationUpdatedPreference') }}</div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="{{ constant('ReservationEvent::Updated') }}" name="{{ constant('ReservationEvent::Updated') }}"
                                    {% if Updated is defined and Updated %}checked="checked" {% endif %}>
                                <label class="form-check-label"
                                    for="{{ constant('ReservationEvent::Updated') }}">{{ translate('PreferenceSendEmail') }}</label>
                            </div>
                        </div>

                        <div class="notification-row col-12 col-sm-6">
                            <div class="notification-type">
                                {{ translate('ReservationDeletedPreference') }}
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="{{ constant('ReservationEvent::Deleted') }}" name="{{ constant('ReservationEvent::Deleted') }}"
                                    {% if Deleted is defined and Deleted %}checked="checked" {% endif %}>
                                <label class="form-check-label"
                                    for="{{ constant('ReservationEvent::Deleted') }}">{{ translate('PreferenceSendEmail') }}</label>
                            </div>

                        </div>

                        <div class="notification-row alt col-12 col-sm-6">
                            <div class="notification-type">
                                {{ translate('ReservationApprovalPreference') }}
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="{{ constant('ReservationEvent::Approved') }}" name="{{ constant('ReservationEvent::Approved') }}"
                                    {% if Approved is defined and Approved %}checked="checked" {% endif %}>
                                <label class="form-check-label"
                                    for="{{ constant('ReservationEvent::Approved') }}">{{ translate('PreferenceSendEmail') }}</label>
                            </div>
                        </div>

                        <div class="notification-row col-12 col-sm-6">
                            <div class="notification-type">
                                {{ translate('ReservationParticipationActivityPreference') }}
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="{{ constant('ReservationEvent::ParticipationChanged') }}"
                                    name="{{ constant('ReservationEvent::ParticipationChanged') }}"
                                    {% if ParticipantChanged is defined and ParticipantChanged %}checked="checked" {% endif %}>
                                <label class="form-check-label"
                                    for="{{ constant('ReservationEvent::ParticipationChanged') }}">{{ translate('PreferenceSendEmail') }}</label>
                            </div>
                        </div>

                        <div class="notification-row-alt col-12 col-sm-6">
                            <div class="notification-type">
                                {{ translate('ReservationSeriesEndingPreference') }}
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                    id="{{ constant('ReservationEvent::SeriesEnding') }}" name="{{ constant('ReservationEvent::SeriesEnding') }}"
                                    {% if SeriesEnding is defined and SeriesEnding %}checked="checked" {% endif %}>
                                <label class="form-check-label"
                                    for="{{ constant('ReservationEvent::SeriesEnding') }}">{{ translate('PreferenceSendEmail') }}</label>
                            </div>
                        </div>

                    </div>
                    <div class="form-group d-grid mt-3">
                        <button type="submit" class="btn btn-primary update prompt" name="{{ constant('Actions::SAVE') }}">
                            {{ translate('Update') }}
                        </button>
                    </div>
                </div>
            </form>

        </div>
    {% endif %}

</div>

{{ include('javascript-includes.twig') }}
{{ include('globalfooter.twig') }}
