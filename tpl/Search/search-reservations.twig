{{ include('globalheader.twig', {Select2: true, DataTable: true}) }}

<div class="page-search-reservations">
    <div class="card shadow mb-2">
        <div class="card-body">
            <form role="form" name="searchForm" id="searchForm" method="post" class="row gy-2"
                action="{{ server.SCRIPT_NAME }}?action=search">
                <h1 class="text-center border-bottom mb-2">{{ translate('SearchReservations') }}</h1>
                <div class="form-group col-sm-4">
                    <label for="userFilter" class="fw-bold">{{ translate('User') }}</label>
                    <div class="position-relative">
                        <input id="userFilter" type="text" class="form-control form-control-sm"
                            value="{{ UserNameFilter|escape_once }}" placeholder="{{ translate('User') }}" />
                        <span class="searchclear bi bi-x-circle-fill" ref="userFilter,userId"></span>
                        <input id="userId" type="hidden" {{ formname(key: 'USER_ID') }} value="{{ UserIdFilter }}" />
                    </div>
                </div>

                <div class="form-group col-sm-4">
                    <label for="resources" class="fw-bold">{{ translate('Resources') }}</label>
                    <select id="resources" class="form-select form-select-sm" multiple="multiple"
                        {{ formname(key: 'RESOURCE_ID', multi: true) }}>
                        {% for resource in Resources %}
                            <option value="{{ resource.GetId() }}">{{ resource.GetName()|escape_once }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group col-sm-4">
                    <label for="schedules" class="fw-bold">{{ translate('Schedules') }}</label>
                    <select id="schedules" class="form-select" multiple="multiple"
                        {{ formname(key: 'SCHEDULE_ID', multi: true) }}>
                        {% for schedule in Schedules %}
                            <option value="{{ schedule.GetId() }}">{{ schedule.GetName()|escape_once }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group col-sm-4">
                    <label for="title" class="fw-bold">{{ translate('Title') }}</label>
                    <input type="search" id="title" class="form-control form-control-sm"
                        {{ formname(key: 'RESERVATION_TITLE') }} placeholder="{{ translate('Title') }}" />
                </div>

                <div class="form-group col-sm-4">
                    <label for="description" class="fw-bold">{{ translate('Description') }}</label>
                    <input type="search" id="description" class="form-control form-control-sm"
                        {{ formname(key: 'DESCRIPTION') }} placeholder="{{ translate('Description') }}" />
                </div>

                <div class="form-group col-sm-4">
                    <label for="referenceNumber" class="fw-bold">{{ translate('ReferenceNumber') }}</label>
                    <input type="search" id="referenceNumber" class="form-control form-control-sm"
                        {{ formname(key: 'REFERENCE_NUMBER') }} placeholder="{{ translate('ReferenceNumber') }}" />
                </div>

                <div class="form-group d-flex">
                    <div class="btn-group-sm" data-bs-toggle="buttons">
                        <input type="radio" class="btn-check" id="today" value="today"
                            {{ formname(key: 'AVAILABILITY_RANGE') }} />
                        <label class="btn btn-outline-primary" for="today">
                            <span class="d-none d-sm-inline-block">{{ translate('Today') }}</span>
                            <span> {{ format_date(date: Today, key: 'calendar_dates') }}</span>
                        </label>

                        <input type="radio" class="btn-check" id="tomorrow" value="tomorrow"
                            {{ formname(key: 'AVAILABILITY_RANGE') }} />
                        <label class="btn btn-outline-primary" for="tomorrow">
                            <span class="d-none d-sm-inline-block">{{ translate('Tomorrow') }}</span>
                            <span> {{ format_date(date: Tomorrow, key: 'calendar_dates') }}</span>
                        </label>

                        <input type="radio" class="btn-check" id="thisweek" value="thisweek"
                            {{ formname(key: 'AVAILABILITY_RANGE') }} />
                        <label class="btn btn-outline-primary" for="thisweek">
                            <span class="d-none d-sm-inline-block">{{ translate('ThisWeek') }}</span>
                            <span class="d-sm-none">{{ translate('Week') }}</span>
                        </label>

                        <input type="radio" class="btn-check" id="daterange" value="daterange" checked
                            {{ formname(key: 'AVAILABILITY_RANGE') }} />
                        <label class="btn btn-outline-primary " for="daterange">
                            <i class="bi bi-calendar3-range"></i>
                            <span class="d-none d-sm-inline-block"> {{ translate('DateRange') }}</span>
                        </label>
                    </div>
                    <div class="d-flex ms-5">
                        <div class="form-group px-2">
                            <label for="beginDate" class="visually-hidden">{{ translate('BeginDate') }}</label>
                            <input type="text" id="beginDate" class="form-control form-control-sm w-auto"
                                placeholder="{{ translate('BeginDate') }}" {{ formname(key: 'BEGIN_DATE') }} />
                        </div>
                        <div class="form-group">
                            <label for="endDate" class="visually-hidden">{{ translate('EndDate') }}</label>
                            <input type="text" id="endDate" class="form-control form-control-sm w-auto"
                                placeholder="{{ translate('EndDate') }}" {{ formname(key: 'END_DATE') }} />
                        </div>
                    </div>
                </div>

                <div class="form-group d-grid gy-3">
                    <button type="submit" class="btn btn-primary" value="submit" {{ formname(key: 'SUBMIT') }}>
                        <i class="bi bi-search me-1"></i>{{ translate('SearchReservations') }}</button>
                    <div class="text-center">{{ indicator() }}</div>
                </div>
            </form>
        </div>
    </div>

    <div id="reservation-results"></div>

    {{ csrf_token() }}

    {{ include('javascript-includes.twig', {Select2: true, Clear: true, DataTable: true}) }}
    {{ vendor_js(src: 'jquery-cookie/1.3.1/js/jquery.cookie.js') }}
    {{ jsfile(src: 'ajax-helpers.js') }}
    {{ jsfile(src: 'autocomplete.js') }}
    {{ jsfile(src: 'reservationPopup.js') }}
    {{ jsfile(src: 'reservation-search.js') }}
    {{ jsfile(src: 'search-clear.js') }}

    {{ control('DatePickerSetupControl', {ControlId: 'beginDate', DefaultDate: BeginDate}) }}
    {{ control('DatePickerSetupControl', {ControlId: 'endDate', DefaultDate: EndDate}) }}

    <script type="text/javascript">
        $(document).ready(function() {
            var opts = {
                autocompleteUrl: "{{ Path|raw }}{# raw: JS string context #}ajax/autocomplete.php?type={{ constant('AutoCompleteType::User')|raw }}{# raw: JS string context #}",
                reservationUrlTemplate: "{{ Path|raw }}{# raw: JS string context #}reservation.php?{{ constant('QueryStringKeys::REFERENCE_NUMBER')|raw }}{# raw: JS string context #}=[refnum]",
                popupUrl: "{{ Path|raw }}{# raw: JS string context #}ajax/respopup.php"
            };

            var search = new ReservationSearch(opts);
            search.init();

            $('#resources').select2({
                placeholder: '{{ translate('Resources')|raw }}{# raw: JS string context #}'
            });

            $('#schedules').select2({
                placeholder: '{{ translate('Schedules')|raw }}{# raw: JS string context #}'
            });
        });
    </script>
</div>

{{ include('globalfooter.twig') }}
