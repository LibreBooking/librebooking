{% macro displayGeneralReserved(Slot, Href, SlotRef, OwnershipClass, Draggable, ResourceId, spantype, SlotLabelFactory) %}
    {% set class = '' %}
    {% set color = '' %}
    {% if Slot.IsPending() %}
        {% set class = 'pending' %}
    {% endif %}
    {% if Slot.HasCustomColor() %}
        {# raw: developer-assembled style attribute #}
        {% set color = 'style="background-color:' ~ Slot.Color() ~ ' !important;color:' ~ Slot.TextColor() ~ ' !important;"' %}
    {% endif %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" class="reserved {{ class }} {{ OwnershipClass }} clickres slot"
        resid="{{ Slot.Id() }}" {{ color|raw }} {% if Draggable %}draggable="true" {% endif %} data-resourceId="{{ ResourceId }}"
        id="{{ Slot.Id() }}|{{ Slot.Date().Format('Ymd') }}">{{ Slot.Label(SlotLabelFactory)|escapequotes }}</td>
{% endmacro %}

{% macro displayMyReserved(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, 'mine', true, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayAdminReserved(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, 'admin', true, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayMyParticipating(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, 'participating', false, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayReserved(Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, '', CanViewAdmin, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayPastTime(Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" ref="{{ SlotRef }}" class="pasttime slot"
        draggable="{{ CanViewAdmin }}" resid="{{ Slot.Id() }}" data-resourceId="{{ ResourceId }}">
        {{ Slot.Label(SlotLabelFactory)|escapequotes }}</td>
{% endmacro %}

{% macro displayReservable(Slot, Href, SlotRef, ResourceId, spantype) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" ref="{{ SlotRef }}" class="reservable clickres slot"
        data-href="{{ Href }}" data-start="{{ Slot.BeginDate().Format('Y-m-d H:i:s')|url_encode }}"
        data-end="{{ Slot.EndDate().Format('Y-m-d H:i:s')|url_encode }}" data-resourceId="{{ ResourceId }}">&nbsp;
    </td>
{% endmacro %}

{% macro displayRestricted(Slot, spantype) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" class="restricted slot">&nbsp;</td>
{% endmacro %}

{% macro displayUnreservable(Slot, spantype, SlotLabelFactory) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" class="unreservable slot">
        {{ Slot.Label(SlotLabelFactory) }}</td>
{% endmacro %}

<h1 id="scheduleName" class="text-center"></h1>

{% if Format == 1 %}
    {{ include('Schedule/schedule-reservations-grid-static.tpl') }}
{% else %}
    {% set TodaysDate = now() %}
    {% for date in BoundDates %}
        <div class="alert alert-light">
            <div class="monitor-display-date fw-bold fs-5">{{ formatdate(date) }}</div>
            {% for resource in Resources %}
                {% set style = '' %}
                {% if resource.HasColor() %}
                    {% set style = 'color:' ~ resource.GetTextColor() ~ '!important;background-color:' ~ resource.GetColor() ~ ' !important;' %}
                {% endif %}
                <div class="monitor-display-resource-name fw-bold fs-6">{{ resource.Name|escape_once }}</div>
                {% set slots = DailyLayout.GetLayout(date, resource.Id) %}
                {% for slot in slots %}
                    {% if slot.IsReserved() %}
                        <div class="reserved rounded-1 p-1 mb-1" style="{{ style }}">
                            {{ formatdate(slot.BeginDate(), null, null, 'period_time') }} -
                            {% set slotformat = 'period_time' %}
                            {% if not slot.BeginDate().DateEquals(slot.EndDate()) %}
                                {% set slotformat = 'short_reservation_date' %}
                            {% endif %}
                            {{ formatdate(slot.EndDate(), null, null, slotformat) }}
                            {{ slot.Label(SlotLabelFactory)|escape_once }}
                        </div>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
    {% endfor %}
{% endif %}
