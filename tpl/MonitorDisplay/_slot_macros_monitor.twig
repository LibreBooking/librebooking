{#
  Shared slot-display macros for the monitor / static schedule grid.

  These correspond to the Smarty {function name=display*} blocks previously
  defined inline in tpl/MonitorDisplay/monitor-display-schedule.tpl (and, until
  this migration, inline in monitor-display-schedule.twig).

  The static grid is driven by StaticDisplaySlotFactory, which returns any of
  the eight names below (the four reserved-state variants plus the four
  non-reserved states).  dispatch() branches over all eight and forwards the
  common positional arg superset to each leaf macro; leaves ignore args they do
  not need.
#}

{% macro displayGeneralReserved(Slot, Href, SlotRef, OwnershipClass, Draggable, ResourceId, spantype, SlotLabelFactory) %}
    {% set class = '' %}
    {% set color = '' %}
    {% if Slot.IsPending() %}
        {% set class = 'pending' %}
    {% endif %}
    {% if Slot.HasCustomColor() %}
        {# raw: developer-assembled style attribute #}
        {% set color = 'style="background-color:' ~ Slot.Color() ~ ' !important;color:' ~ Slot.TextColor() ~ ' !important;"' %}
    {% endif %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" class="reserved {{ class }} {{ OwnershipClass }} clickres slot"
        resid="{{ Slot.Id() }}" {{ color|raw }} {% if Draggable %}draggable="true" {% endif %} data-resourceId="{{ ResourceId }}"
        id="{{ Slot.Id() }}|{{ Slot.Date().Format('Ymd') }}">{{ Slot.Label(SlotLabelFactory)|escape_once }}</td>
{% endmacro %}

{% macro displayMyReserved(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, 'mine', true, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayAdminReserved(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, 'admin', true, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayMyParticipating(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, 'participating', false, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayReserved(Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) %}
    {{ _self.displayGeneralReserved(Slot, Href, SlotRef, '', CanViewAdmin, ResourceId, spantype, SlotLabelFactory) }}
{% endmacro %}

{% macro displayPastTime(Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" ref="{{ SlotRef }}" class="pasttime slot"
        draggable="{{ CanViewAdmin }}" resid="{{ Slot.Id() }}" data-resourceId="{{ ResourceId }}">
        {{ Slot.Label(SlotLabelFactory)|escape_once }}</td>
{% endmacro %}

{% macro displayReservable(Slot, Href, SlotRef, ResourceId, spantype) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" ref="{{ SlotRef }}" class="reservable clickres slot"
        data-href="{{ Href|raw }}" data-start="{{ Slot.BeginDate().Format('Y-m-d H:i:s')|url_encode }}"
        data-end="{{ Slot.EndDate().Format('Y-m-d H:i:s')|url_encode }}" data-resourceId="{{ ResourceId }}">&nbsp;
    </td>
{% endmacro %}

{% macro displayRestricted(Slot, spantype) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" class="restricted slot">&nbsp;</td>
{% endmacro %}

{% macro displayUnreservable(Slot, spantype, SlotLabelFactory) %}
    <td {{ (spantype ?? 'col') }}span="{{ Slot.PeriodSpan() }}" class="unreservable slot">
        {{ Slot.Label(SlotLabelFactory)|escape_once }}</td>
{% endmacro %}

{#
  Dispatch the computed function name to the matching macro.
  StaticDisplaySlotFactory can return any of the eight names below.
#}
{% macro dispatch(fnName, Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) %}
    {%- if fnName == 'displayMyReserved' -%}
        {{ _self.displayMyReserved(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) }}
    {%- elseif fnName == 'displayMyParticipating' -%}
        {{ _self.displayMyParticipating(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) }}
    {%- elseif fnName == 'displayAdminReserved' -%}
        {{ _self.displayAdminReserved(Slot, Href, SlotRef, ResourceId, spantype, SlotLabelFactory) }}
    {%- elseif fnName == 'displayReserved' -%}
        {{ _self.displayReserved(Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) }}
    {%- elseif fnName == 'displayRestricted' -%}
        {{ _self.displayRestricted(Slot, spantype) }}
    {%- elseif fnName == 'displayPastTime' -%}
        {{ _self.displayPastTime(Slot, Href, SlotRef, ResourceId, CanViewAdmin, spantype, SlotLabelFactory) }}
    {%- elseif fnName == 'displayReservable' -%}
        {{ _self.displayReservable(Slot, Href, SlotRef, ResourceId, spantype) }}
    {%- else -%}
        {{ _self.displayUnreservable(Slot, spantype, SlotLabelFactory) }}
    {%- endif -%}
{% endmacro %}
