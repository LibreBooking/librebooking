                                            href="{{ Path }}admin/manage_theme.php">{{ translate('LookAndFeel') }}</a>
                                    </li>
                                    <li id="navImport"><a class="dropdown-item"
                                            href="{{ Path }}admin/ics_import.php">{{ translate('Import') }}</a>
                                    </li>
                                    <li id="navServerSettings"><a class="dropdown-item"
                                            href="{{ Path }}admin/server_settings.php">{{ translate('ServerSettings') }}</a>
                                    </li>
