                                        </li>
                                        <li id="navNewVersion" class="new-version">
                                            <a class="dropdown-item"
                                                href="https://github.com/LibreBooking/librebooking/releases">{{ translate('WhatsNew') }}</a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </li>
                        {% endif %}
                        {% if LoggedIn is defined and LoggedIn and AvailableLanguages|length > 1 %}
                            <li class="nav-item dropdown" id="navLanguageDropdown">
                                <a href="#" class="nav-link link-primary dropdown-toggle" role="button"
                                    data-bs-toggle="dropdown" aria-label="{{ translate('ChangeLanguage') }}"
                                    title="{{ translate('ChangeLanguage') }}">
                                    <span class="visually-hidden">{{ translate('ChangeLanguage') }}</span>
                                    <i class="bi bi-globe-americas" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" id="languageDropdownMenu"
                                    style="max-height: 70vh; overflow-y: auto; min-width: 14rem;">
                                    {% for lang in AvailableLanguages %}
                                        <li>
                                            <a class="dropdown-item {% if CurrentLanguage == lang.GetLanguageCode() %}active{% endif %}"
                                                href="#" data-lang-code="{{ lang.GetLanguageCode() }}">
                                                {{ lang.GetDisplayName() }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
