                                    data-bs-toggle="dropdown">
                                    <span class="visually-hidden">Configuration</span>
                                    <i class="bi bi-gear-fill"></i>
                                    {% if ShowNewVersion is defined and ShowNewVersion %}<span
                                            class="badge badge-new-version new-version"
                                        id="newVersionBadge">{{ translate('NewVersion') }}</span>{% endif %}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    {% if EnableConfigurationPage is defined and EnableConfigurationPage %}
                                        <li id="navManageConfiguration"><a class="dropdown-item"
                                                href="{{ Path }}admin/manage_configuration.php">{{ translate('ManageConfiguration') }}</a>
                                        </li>
                                    {% endif %}
                                    <li id="navEmailTemplates"><a class="dropdown-item"
                                            href="{{ Path }}admin/manage_email_templates.php">{{ translate('ManageEmailTemplates') }}</a>
