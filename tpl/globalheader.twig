                                    <ul class="dropdown-menu">
                                        <li id="navGenerateReport">
                                            <a class="dropdown-item"
                                                href="{{ Path }}reports/{{ constant('Pages::REPORTS_GENERATE') }}">{{ translate('GenerateReport') }}</a>
                                        </li>
                                        <li id="navSavedReports">
                                            <a class="dropdown-item"
                                                href="{{ Path }}reports/{{ constant('Pages::REPORTS_SAVED') }}">{{ translate('MySavedReports') }}</a>
                                        </li>
                                        <li id="navCommonReports">
                                            <a class="dropdown-item"
                                                href="{{ Path }}reports/{{ constant('Pages::REPORTS_COMMON') }}">{{ translate('CommonReports') }}</a>
                                        </li>
                                    </ul>
                                </li>
                            {% endif %}
                        {% endif %}

                    </ul>
                    <ul class="navbar-nav navbar-right">
                        {% if ShowScheduleLink is defined and ShowScheduleLink %}
                            <li class="nav-item dropdown" id="navScheduleDropdown">
                                <a href="#" class="nav-link link-primary dropdown-toggle" role="button"
                                    data-bs-toggle="dropdown">{{ translate('Schedule') }}</a>
                                <ul class="dropdown-menu">
                                    <li id="navViewSchedule"><a class="dropdown-item"
                                            href="view-schedule.php">{{ translate('ViewSchedule') }}</a>
                                    </li>
                                    <li id="navViewCalendar"><a class="dropdown-item"
                                            href="view-calendar.php">{{ translate('ViewCalendar') }}</a>
                                    </li>
                                </ul>
                            </li>
                        {% endif %}
