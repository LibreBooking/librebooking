                                            href="{{ Path }}{{ constant('Pages::SEARCH_RESERVATIONS') }}">{{ translate('SearchReservations') }}</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown" id="navReportsDropdown">
                                <a href="#" class="nav-link link-primary dropdown-toggle" role="button"
                                    data-bs-toggle="dropdown">{{ translate('Check') }}</a>
                                <ul class="dropdown-menu">
                                    <li id="CheckResources"><a class="dropdown-item"
                                            href="{{ Path }}view_resources.php">{{ translate('Resources') }}</a>
                                    </li>
                                    <li id="CheckSchedules"><a class="dropdown-item"
                                            href="{{ Path }}view_schedules.php">{{ translate('Schedules') }}</a>
                                    </li>
                                </ul>
                            </li>
                            {% if CanViewAdmin is defined and CanViewAdmin %}
                                <li class="nav-item dropdown" id="navApplicationManagementDropdown">
                                    <a href="#" class="nav-link link-primary dropdown-toggle" role="button"
                                        data-bs-toggle="dropdown">{{ translate('ApplicationManagement') }}</a>
                                    <ul class="dropdown-menu">
                                        <li id="navManageReservations"><a class="dropdown-item"
                                                href="{{ Path }}admin/manage_reservations.php">{{ translate('ManageReservations') }}</a>
                                        </li>
                                        <li id="navManageBlackouts"><a class="dropdown-item"
                                                href="{{ Path }}admin/manage_blackouts.php">{{ translate('ManageBlackouts') }}</a>
                                        </li>
                                        <li id="navManageQuotas"><a class="dropdown-item"
                                                href="{{ Path }}admin/manage_quotas.php">{{ translate('ManageQuotas') }}</a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li id="navManageSchedules"><a class="dropdown-item"
                                                href="{{ Path }}admin/manage_schedules.php">{{ translate('ManageSchedules') }}</a>
                                        <li id="navManageResources"><a class="dropdown-item"
                                                href="{{ Path }}admin/manage_resources.php">{{ translate('ManageResources') }}</a>
