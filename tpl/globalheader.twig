                        <li class="nav-item dropdown" id="navHelpDropdown">
                            <a href="#" class="nav-link link-primary dropdown-toggle" role="button"
                                data-bs-toggle="dropdown">{{ translate('Help') }}</a>
                            <ul class="dropdown-menu  dropdown-menu-end">
                                <li id="navHelp"><a class="dropdown-item"
                                        href="https://librebooking.readthedocs.io/en/latest/">{{ translate('Help') }}</a>
                                </li>
                                {% if CanViewAdmin is defined and CanViewAdmin %}
                                    <li id="navHelpAdmin"><a class="dropdown-item"
                                            href="https://librebooking.readthedocs.io/en/latest/ADMINISTRATION.html">{{ translate('Administration') }}</a>
                                    </li>
                                {% endif %}
                                <li id="navAbout"><a class="dropdown-item"
                                        href="{{ Path }}help.php?ht=about">{{ translate('About') }}</a></li>
                            </ul>
                        </li>
                        {% if LoggedIn is defined and LoggedIn %}
                            <li class="nav-item" id="navSignOut"><a class="nav-link link-primary"
                                    href="{{ Path }}logout.php">{{ translate('SignOut') }}</a></li>
                        {% else %}
                            <li class="nav-item" id="navLogIn"><a class="nav-link  link-primary"
                                    href="{{ Path }}index.php">{{ translate('LogIn') }}</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    {% endif %}

<div id="main" class="container-fluid my-3" role="main">
