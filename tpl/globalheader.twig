                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li id="navFindATime"><a class="dropdown-item"
                                            href="{{ Path }}{{ constant('Pages::OPENINGS') }}">{{ translate('FindATime') }}</a>
