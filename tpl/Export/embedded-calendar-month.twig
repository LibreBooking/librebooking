{% extends 'Export/embedded-calendar-container.twig' %}
{% block calendar %}
    <div class="booked-calendar-month">
        {% set weekStart = Range.GetBegin() %}
        <div class="booked-weekday-names">
        {% for day in range(0, 6) %}
            <div class="booked-weekday-name"style="width:{{ Width }}">
                {% if day == 0 %}{{ translate('DaySundayAbbr') }}{% endif %}
                {% if day == 1 %}{{ translate('DayMondayAbbr') }}{% endif %}
                {% if day == 2 %}{{ translate('DayTuesdayAbbr') }}{% endif %}
                {% if day == 3 %}{{ translate('DayWednesdayAbbr') }}{% endif %}
                {% if day == 4 %}{{ translate('DayThursdayAbbr') }}{% endif %}
                {% if day == 5 %}{{ translate('DayFridayAbbr') }}{% endif %}
                {% if day == 6 %}{{ translate('DaySaturdayAbbr') }}{% endif %}
            </div>
        {% endfor %}
        </div>
        {% for week in range(0, 5) %}
            {% set weekStart = Range.GetBegin().AddDays(7 * week) %}
            {% if weekStart.LessThan(Range.GetEnd()) %}
                <div class="booked-calendar-week">
                {% for day in range(0, 6) %}
                    {% set date = weekStart.AddDays(day) %}
                    <div class="booked-week-date" style="width:{{ Width }}">
                        <div class="booked-week-date-title {% if date.DateEquals(now()) %}booked-today{% endif %}">
                            <a href="{{ ScheduleUrl }}{{ format_date(date: date, timezone: Timezone, key: 'url') }}"
                               title="{{ translate('ViewCalendar') }}">{{ format_date(date: date, timezone: Timezone, format: 'd') }}</a>
                        </div>
                        {% for r in Reservations.OnDate(date).Reservations() %}
                        {% set color = r.GetColor() %}
                            <div class="booked-day-events">
                                <a class="booked-calendar-event"
                                   href="{{ ReservationUrl }}{{ r.ReferenceNumber() }}"
                                   title="{{ translate('ViewReservation') }}"
                                   {% if color is not empty %}style="background-color:{{ r.GetColor() }} !important;color:{{ r.GetTextColor() }} !important;border-color:{{ r.GetBorderColor() }} !important"
                                   {% endif %}>
                                    {{ TitleFormatter.Format(r, date)|raw }}
                                </a>
                            </div>
                        {% else %}
                            &nbsp;
                        {% endfor %}

                    </div>
                {% endfor %}
                </div>
            {% endif %}

        {% endfor %}
    </div>
{% endblock %}
