{{ include('globalheader.twig') }}
<div id="page-checkout">

    <div class="card shadow">
        <div class="card-body">
            <h1 class="border-bottom mb-3">
                {{ translate('Checkout') }}
            </h1>
            <script
                src="https://www.paypal.com/sdk/js?client-id={{ PayPalClientId }}&intent=capture&currency={{ Currency }}&commit=true&disable-funding=credit">
            </script>
            <script src="https://checkout.stripe.com/checkout.js"></script>

            <div id="checkoutPage">

                {% if not IsCartEmpty %}
                    <div class="cart row gy-2" id="cart">
                        <div class="col-12 col-sm-4">
                            <h4>{{ translate('PurchaseSummary') }}</h4>
                            <div class="d-flex justify-content-between">
                                <div class="ms-2">
                                    {{ translate('CreditsEachCost1') }} {{ CreditCount }} {{ translate('CreditsEachCost2') }}
                                </div>
                                <div class="text-end">{{ CreditCost }}</div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <div class="ms-2">{{ translate('Quantity') }}</div>
                                <div class="text-end">{{ CreditQuantity }}</div>
                            </div>

                            <div class="d-flex justify-content-between border-top fw-bold pt-2 mt-2">
                                <div class="total ms-2">{{ translate('Total') }}</div>
                                <div class="text-end">{{ Total }}</div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-8">
                            <div class="checkout-buttons row g-2">
                                {% if PayPalEnabled %}
                                    <div class="col-12 col-md-6">
                                        <div id="paypal-button"></div>
                                    </div>
                                {% endif %}

                                {% if StripeEnabled %}
                                    <div class="col-12 col-md-6">
                                        <button id="stripe-button" class="btn btn-outline-secondary w-100" type="button">
                                            <i class="bi bi-credit-card me-1"></i> {{ translate('PayWithCard') }}
                                        </button>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                {% else %}
                    <div class="alert alert-danger">
                        {{ translate('EmptyCart') }} <a href="{{ ScriptUrl }}/{{ constant('Pages::CREDITS') }}#purchase"
                            class="alert-link">{{ translate('BuyCredits') }}</a>
                    </div>
                {% endif %}

                <div class="d-none mt-2" id="success">
                    <div class="alert alert-success">
                        <div>{{ translate('Success') }}</div>
                        <div><em>{{ CreditQuantity * CreditCount }}</em> {{ translate('CreditsPurchased') }}</div>
                        <div><a href="{{ ScriptUrl }}/{{ constant('Pages::CREDITS') }}"
                                class="alert-link">{{ translate('ViewYourCredits') }}</a>
                        </div>
                    </div>
                </div>

                <div class="d-none mt-2" id="error">
                    <div class="alert alert-danger">
                        <div>{{ translate('PurchaseFailed') }}</div>
                        <div><a href="{{ ScriptUrl }}/{{ constant('Pages::CREDITS') }}#purchase"
                                class="alert-link">{{ translate('TryAgain') }}</a></div>
                    </div>
                </div>

                {{ csrf_token() }}

                {{ include('javascript-includes.twig') }}
                {{ jsfile(src: 'ajax-helpers.js') }}

                <script type="text/javascript">
                    $(function() {
                        {% if PayPalEnabled %}

                            var CREATE_PAYMENT_URL = '{{ server.SCRIPT_NAME|raw }}?action=createPayPalPayment'; {# raw: JS string context #}
                            var EXECUTE_PAYMENT_URL = '{{ server.SCRIPT_NAME|raw }}?action=executePayPalPayment'; {# raw: JS string context #}

                            paypal.Buttons({
                                createOrder: function(data, actions) {

                                    const fd = new FormData();
                                    fd.append("CSRF_TOKEN", $('#csrf_token').val());
                                    // CSRF_TOKEN: $('#csrf_token').val()
                                    return fetch(CREATE_PAYMENT_URL, {
                                        method: 'POST',
                                        body: fd,
                                        credentials: "include",
                                    }).then(function(res) {
                                        return res.json();
                                    }).then(function(data) {
                                        return data.id;
                                    });
                                    // return paypal.request.post(CREATE_PAYMENT_URL, {
                                    //     CSRF_TOKEN: $('#csrf_token').val()
                                    // }).then(function (res) {
                                    //     return res.id;
                                    // });
                                },

                                onApprove: function(data, actions) {
                                    const fd = new FormData();
                                    fd.append("CSRF_TOKEN", $('#csrf_token').val());
                                    fd.append("paymentID", data.orderID);
                                    return fetch(EXECUTE_PAYMENT_URL, {
                                        method: 'POST',
                                        body: fd,
                                        credentials: "include"
                                    }).then(function(res) {
                                        return res.json();
                                    }).then(function(res) {
                                        $('#cart').addClass('d-none');
                                        if (res.status != "COMPLETED") {
                                            $('#error').removeClass('d-none');
                                        } else {
                                            $('#success').removeClass('d-none');
                                        }
                                    });
                                }
                                // return paypal.request.post(EXECUTE_PAYMENT_URL, {
                                //     paymentID: data.paymentID, payerID: data.payerID, CSRF_TOKEN: $('#csrf_token').val()
                                // }).then(function (data) {
                                //     $('#cart').addClass('no-show');
                                //     if (data.state != "approved")
                                //     {
                                //         $('#error').removeClass('no-show');
                                //     }
                                //     else
                                //     {
                                //         $('#success').removeClass('no-show');
                                //     }
                                // });

                                // onError: function (err) {
                                //     $('#error').removeClass('no-show');
                                // }

                            }).render('#paypal-button');

                        {% endif %}

                        {% if StripeEnabled %}

                            var executeStripePaymentUrl = '{{ server.SCRIPT_NAME|raw }}?action=executeStripePayment'; {# raw: JS string context #}
                            var handler = StripeCheckout.configure({
                                key: '{{ StripePublishableKey|raw }}', {# raw: JS string context #}
                                image: 'https://stripe.com/img/documentation/checkout/marketplace.png',
                                zipCode: true,
                                locale: 'auto',
                                currency: '{{ Currency|raw }}', {# raw: JS string context #}
                                email: '{{ Email|html_entity_decode|escape_js }}',
                                token: function(token) {
                                    var data = {
                                        CSRF_TOKEN: $('#csrf_token').val(),
                                        STRIPE_TOKEN: token.id
                                    };

                                    $.post(executeStripePaymentUrl, data, function(d) {
                                        $('#cart').addClass('d-none');

                                        if (d.result != true) {
                                            $('#error').removeClass('d-none');
                                        } else {
                                            $('#success').removeClass('d-none');
                                        }
                                    });
                                }
                            });

                            document.getElementById('stripe-button').addEventListener('click', function(e) {
                                handler.open({
                                    name: '{{ translate('BuyMoreCredits') }}', description: '{{ Total|raw }}', amount: {{ TotalUnformatted * 100 }} {# raw: JS string context #}
                                });
                                e.preventDefault();
                            });

                            window.addEventListener('popstate', function() {
                                handler.close();
                            });

                        {% endif %}
                    });
                </script>

            </div>
        </div>
    </div>
</div>

{{ include('globalfooter.twig') }}
