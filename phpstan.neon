includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 5
    errorFormat: prettyJson
    tmpDir: var/cache/phpstan/base
    treatPhpDocTypesAsCertain: false
    paths:
        - Controls
        - Domain
        - Jobs
        - Pages
        - Presenters
        - Web
        - WebServices
        - config
        - lang
        - lib
        - phing-tasks
        # Keep `plugins` in paths so PHPStan can scan symbols used via dynamic plugin loading.
        - plugins
        - scripts
        - src
        - tests
    excludePaths:
        analyse:
            - lib/external/
            # Third-party libraries bundled with plugins (adLDAP, phpCAS).
            - plugins/Authentication/ActiveDirectory/adLDAP.php
            - plugins/Authentication/ActiveDirectory/classes/
            - plugins/Authentication/ActiveDirectory/collections/
            - plugins/Authentication/CAS/CAS-1.3.8/
    bootstrapFiles:
        - vendor/autoload.php
    # Declarations of symbols from applications that plugins integrate with
    # but that are not dependencies of this project.
    scanFiles:
        - tests/phpstan-stubs/SimpleSAML.symbols
        - tests/phpstan-stubs/WordPress.symbols
    # Corrected PHPDoc for third-party code that cannot be edited.
    stubFiles:
        - tests/phpstan-stubs/FeedWriter.stub
        - tests/phpstan-stubs/Smarty.stub
