includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 5
    errorFormat: prettyJson
    tmpDir: var/cache/phpstan/base
    treatPhpDocTypesAsCertain: false
    paths:
        - Controls
        - Domain
        - Jobs
        - Pages
        - Presenters
        - Web
        - WebServices
        - config
        - lang
        - lib
        - phing-tasks
        # Keep `plugins` in paths so PHPStan can scan symbols used via dynamic plugin loading.
        - plugins
        - scripts
        - src
        - tests
    excludePaths:
        analyse:
            - build/ (?)
            - lib/external/
            # Third-party libraries bundled with plugins (adLDAP, phpCAS).
            - plugins/Authentication/ActiveDirectory/adLDAP.php
            - plugins/Authentication/ActiveDirectory/classes/
            - plugins/Authentication/ActiveDirectory/collections/
            - plugins/Authentication/CAS/CAS-1.3.8/
            - tpl_c/ (?)
            - vendor/
            # Staged plugin rollout: remove these one-by-one as each plugin
            # is fixed. They stay in `paths` for symbol discovery.
            - plugins/Authentication/ActiveDirectory/
            - plugins/Authentication/Ldap/
            - plugins/Authentication/Moodle/
            - plugins/Authentication/MoodleAdv/
            - plugins/Authentication/Saml/
            - plugins/Authentication/Shibboleth/
            - plugins/Authentication/WordPress/
    bootstrapFiles:
        - vendor/autoload.php
    # Corrected PHPDoc for third-party code that cannot be edited.
    stubFiles:
        - tests/phpstan-stubs/FeedWriter.stub
        - tests/phpstan-stubs/Smarty.stub
