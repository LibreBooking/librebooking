{
    "name": "librebooking/librebooking",
    "description": "LibreBooking",
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "LibreBooking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibreBooking\\Tests\\": "tests/src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.3",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "guzzlehttp/guzzle": "^7.0",
        "vincentlanglet/twig-cs-fixer": "^4.1",
        "psalm/phar": "^7.11"
    },
    "require": {
        "php": ">=8.4",
        "smarty/smarty": "^5.9",
        "stripe/stripe-php": "^23.1",
        "monolog/monolog": "^3.12",
        "google/recaptcha": "2.2.*",
        "gregwar/captcha": "^2.1",
        "google/apiclient": "^2.20",
        "microsoft/microsoft-graph": "^3.10",
        "joelbutcher/facebook-graph-sdk": "^6.1",
        "mobiledetect/mobiledetectlib": "^4.11",
        "bacon/bacon-qr-code": "^3.1",
        "mibe/feedwriter": "^1.1",
        "sabre/vobject": "^5.0",
        "egulias/email-validator": "^4.0",
        "phpmailer/phpmailer": "^7.2",
        "claviska/simpleimage": "^4.4",
        "mashape/unirest-php": "^3.0",
        "vlucas/phpdotenv": "^5.8",
        "pear/net_ldap2": "^2.3",
        "ext-intl": "*",
        "ext-ldap": "*",
        "symfony/html-sanitizer": "^7.4",
        "league/uri": "^7.10",
        "twig/twig": "^3.30"
    },
    "scripts": {
        "install-tools": "phive install --trust-gpg-keys",
        "build": "./tools/phing",
        "phpcsfixer:fix": "./vendor/bin/php-cs-fixer fix -v",
        "phpcsfixer:lint": "./vendor/bin/php-cs-fixer fix -vv --dry-run",
        "twigcsfixer:fix": "./vendor/bin/twig-cs-fixer fix tpl lang",
        "twigcsfixer:lint": "./vendor/bin/twig-cs-fixer lint tpl lang",
        "phpunit": "./vendor/bin/phpunit",
        "psalm": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/psalm.phar --config=psalm.xml --long-progress"
        ],
        "phpstan": "./vendor/bin/phpstan analyse",
        "phpstan_next": "./vendor/bin/phpstan analyse -c phpstan_next.neon",
        "phpstan:baseline": "./vendor/bin/phpstan analyze --generate-baseline",
        "test": [
            "@phpunit",
            "@phpcsfixer:lint",
            "@twigcsfixer:lint"
        ],
        "preflight": "php lib/preflight.php",
        "test:integration": "./vendor/bin/phpunit --testsuite integration --testdox",
        "test:integration:db": "./vendor/bin/phpunit tests/Integration/Database --testdox",
        "config-dist:generate": "php scripts/generate-config-dist.php --write",
        "config-dist:check": "php scripts/generate-config-dist.php --check",
        "env-example:generate": "php scripts/generate-env-example.php --write",
        "env-example:check": "php scripts/generate-env-example.php --check"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.4.0"
        }
    }
}
