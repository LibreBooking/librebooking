    Резервационна информация:
    <br/>
    <br/>

    Потребител: {{ UserName|raw }}
    Начало: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Край: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Ресурси ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Ресурс:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>График:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>Идентификатор на ресурс:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Местоположение:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>Контакт:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>Описание:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Бележки:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Администратор на ресурса:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Детайли за ресурса:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Заглавие: {{ Title|escape_once }}<br/>
    Описание: {{ Description|escape_once }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Резервацията се отнася за следните дати::
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Аксесоари:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}<br/>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Един или повече от ресурсите изискват одобрение преди употреба.  Моля, убедете се, че тази заявка за резервация е одобрена или отхвърлена.
    {% endif %}

    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Разгледай тази резервация</a> | <a href="{{ ScriptUrl|raw }}">Влизане в LibreBooking</a>
