    Bokningsdetaljer:
    <br/>
    <br/>

    Er tid börjar: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Välkommen till oss 10min innan bokad tid.<br/>

    Slutar: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Resurser ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Resurs:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>Schema:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>Resurs-ID:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Plats:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>Beskrivning:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Anteckningar:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Resursadministratör:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Resursdetaljer:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    <br/>

    <br/>
    Rubrik: {{ Title|escape_once }}<br/>
    <br/>
    Beskrivning: {{ Description|escape_once|nl2br }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Ni har reserverat följande tid / er:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if RequiresApproval %}
        <br/>
        Innan er reservation övergår i bokning behöver den godkännas först.
    {% endif %}

    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Visa Bokning</a> |
    <a href="{{ ScriptUrl|raw }}/{{ ICalUrl|raw }}">Lägg till i Outlook</a> |
    <a href="{{ ScriptUrl|raw }}">Logga in i Bokningsprogrammet</a>
