Reservation Details:
<br/>
<br/>

User: {{ UserName|raw }}<br/>
Starting: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
Ending: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
{% if ResourceNames|default([])|length > 1 %}
    Resources:
    <br/>
    {% for resourceName in ResourceNames %}
        {{ resourceName|escape_once }}
        <br/>
    {% endfor %}
{% else %}
    Resource: {{ ResourceName|escape_once }}
    <br/>
{% endif %}

{% if ResourceImage %}
    <div class="resource-image"><img src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

Title: {{ Title|escape_once }}<br/>
Description: {{ Description|escape_once|nl2br }}
{{ DeleteReason|escape_once|nl2br }}<br/>

{% if RepeatDates|length > 0 %}
    <br/>
    The following dates have been removed:
    <br/>
{% endif %}

{% for date in RepeatDates %}
    {{ formatdate(date: date) }}
    <br/>
{% endfor %}

{% if Accessories|default([])|length > 0 %}
    <br/>
    Accessories:
    <br/>
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}
        <br/>
    {% endfor %}
{% endif %}

<br/>
<br/>
<a href="{{ ScriptUrl|raw }}">Log in to LibreBooking</a>
