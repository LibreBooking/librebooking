Reservation Details:
<br/>
<br/>

User: {{ UserName|raw }}<br/>
{% if CreatedBy %}
    Created by: {{ CreatedBy|raw }}
    <br/>
{% endif %}
Starting: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
Ending: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Tài nguyên ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Tài nguyên:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>Lịch:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>Mã tài nguyên:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Vị trí:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>Liên hệ:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>Mô tả:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Ghi chú:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Quản trị viên tài nguyên:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Chi tiết tài nguyên:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

Title: {{ Title|escape_once }}<br/>
Description: {{ Description|escape_once|nl2br }}

{% if RepeatDates|length > 0 %}
    <br/>
    The reservation occurs on the following dates:
    <br/>
{% endif %}

{% for date in RepeatDates %}
    {{ formatdate(date: date) }}
    <br/>
{% endfor %}

{% if Accessories|default([])|length > 0 %}
    <br/>
    Accessories:
    <br/>
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}
        <br/>
    {% endfor %}
{% endif %}

{% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
        <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}

{% if RequiresApproval %}
    <br/>
    At least one of the resources reserved requires approval before usage. Please ensure that this reservation request is approved or rejected.
{% endif %}

{% if CheckInEnabled %}
    <br/>
    At least one of the resources reserved requires that the user check in and out of the reservation.
    {% if AutoReleaseMinutes is not null %}
        This reservation will be cancelled unless the user checks in within {{ AutoReleaseMinutes|raw }} minutes after the scheduled start time.
    {% endif %}
{% endif %}

<br/>
<br/>
<a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">View this reservation</a> | <a href="{{ ScriptUrl|raw }}">Log in to LibreBooking</a>
