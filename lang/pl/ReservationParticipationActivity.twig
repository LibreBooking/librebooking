<p>{{ ParticipantDetails|raw }}
    {% if (InvitationAction == constant('InvitationAction::Decline') or InvitationAction == constant('InvitationAction::CancelAll') or InvitationAction == constant('InvitationAction::CancelInstance')) %}
        odrzucił/a Twoje zaproszenie do rezerwacji.
    {% elseif (InvitationAction == constant('InvitationAction::Join') or InvitationAction == constant('InvitationAction::JoinAll')) %}
        Dołączył/a do Twojej rezerwacji.
    {% else %}
        Zaakceptował/a Twoją rezerwację.
    {% endif %}
</p>
<p><strong>Szczegóły rezerwacji:</strong></p>

<p>
    <strong>Początek:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    <strong>Koniec:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
    <strong>Tytuł:</strong> {{ Title|escape_once }}<br/>
    <strong>Opis:</strong> {{ Description|escape_once|nl2br }}
    {% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
    <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}
</p>

<p>
    {% if ResourceNames|default([])|length > 1 %}
        <strong>Zasoby ({{ ResourceNames|default([])|length }}):</strong>
        <br/>
        {% for resourceName in ResourceNames %}
            {{ resourceName|escape_once }}
            <br/>
        {% endfor %}
    {% else %}
        <strong>Zasób:</strong>
        {{ ResourceName|escape_once }}
        <br/>
    {% endif %}
</p>

{% if ResourceImage %}
    <div class="resource-image"><img alt="{{ ResourceName|escape_once }}" src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

<p><strong>Numer referencyjny:</strong> {{ ReferenceNumber|raw }}</p>

<p>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Pokaż rezerwację</a> |
    <a href="{{ ScriptUrl|raw }}">Zaloguj się do {{ AppTitle|raw }}</a>
</p>
