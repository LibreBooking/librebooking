<p>
    {{ FullName|raw }},
</p>

<p>
    Uma conta em {{ AppTitle|raw }} foi criada para você com os seguintes detalhes:
    <br />
    E-mail: {{ EmailAddress|raw }}
    <br />
    Nome: {{ FullName|raw }}
    <br />
    Telefone: {{ Phone|raw }}
    <br />
    Organização: {{ Organization|raw }}
    <br />
    Posição: {{ Position|raw }}
    <br />
    Senha: {{ Password }}
    {% if CreatedBy %}
        <br />
        Criada por: {{ CreatedBy|raw }}
    {% endif %}
</p>

<p>
    <a href="{{ ScriptUrl|raw }}">Acessar {{ AppTitle|raw }}</a>
</p>
