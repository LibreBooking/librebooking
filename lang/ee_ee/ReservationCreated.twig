    Broneeringu detailid:
    <br/>
    <br/>

    Algus: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Lõpp: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Ressursid ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Ressurss:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>Graafik:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>Ressursi ID:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Asukoht:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>Kirjeldus:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Märkused:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Ressursi administraator:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Ressursi üksikasjad:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Pealkiri: {{ Title|escape_once }}<br/>
    Kirjeldus: {{ Description|escape_once|nl2br }}<br/>
    <br/>
    Ootame Teid broneeritud ajal!<br/>
    Rannahall

    {% if RepeatDates|length > 0 %}
        <br/>
        The reservation occurs on the following dates:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Accessories:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        One or more of the resources reserved require approval before usage.  This reservation will be pending until it is approved.
    {% endif %}

    {% if ApprovedBy %}
        <br/>
        Approved by: {{ ApprovedBy|raw }}
    {% endif %}

    {% if CreatedBy %}
        <br/>
        Broneerija: {{ CreatedBy|raw }}
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Vaata broneeringut</a> |
    <a href="{{ ScriptUrl|raw }}/{{ ICalUrl|raw }}">Lisa kalendrisse</a> |
    <a href="{{ ScriptUrl|raw }}">Logi sisse Rannahalli kalendrisse</a>
