    פרטי הזמנה:
    <br/>
    <br/>

    משתמש: {{ UserName|raw }}
    החל מ-: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    עד: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>משאבים ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>משאב:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>לוח זמנים:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>מזהה משאב:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>מיקום:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>איש קשר:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>תיאור:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>הערות:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>מנהל משאב:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>פרטי המשאב:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

        כותר: {{ Title|escape_once }}<br/>
    תאור: {{ Description|escape_once }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        ההזמנה קיימת בתאריכים אלו:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>אביזרים:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}<br/>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
                לאחד או יותר מהמשאבים המוזמנים דרוש אישור לפני שימוש. נא לוודא אישור של בקשת הזמנה זו.
    {% endif %}

    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">לצפות בהזמנה זו</a> | <a href="{{ ScriptUrl|raw }}">כניסה ל-LibreBooking</a>
