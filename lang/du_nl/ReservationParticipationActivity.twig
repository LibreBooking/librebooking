<p>{{ ParticipantDetails|raw }} heeft
    {% if (InvitationAction == constant('InvitationAction::Decline') or InvitationAction == constant('InvitationAction::CancelAll') or InvitationAction == constant('InvitationAction::CancelInstance')) %}
        jouw reservering geweigerd.
    {% elseif (InvitationAction == constant('InvitationAction::Join') or InvitationAction == constant('InvitationAction::JoinAll')) %}
        zich aangesloten bij jouw reservering.
    {% else %}
        jouw uitnodiging bij de reservering bevestigd.
    {% endif %}
</p>
<p><strong>Reservering details:</strong></p>

<p>
    <strong>Start:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    <strong>Eind:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
    <strong>Titel:</strong> {{ Title|escape_once }}<br/>
    <strong>Omschrijving:</strong> {{ Description|escape_once|nl2br }}
    {% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
    <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}
</p>

<p>
    {% if ResourceNames|default([])|length > 1 %}
        <strong>Bron ({{ ResourceNames|default([])|length }}):</strong>
        <br/>
        {% for resourceName in ResourceNames %}
            {{ resourceName|escape_once }}
            <br/>
        {% endfor %}
    {% else %}
        <strong>Resource:</strong>
        {{ ResourceName|escape_once }}
        <br/>
    {% endif %}
</p>

{% if ResourceImage %}
    <div class="resource-image"><img alt="{{ ResourceName|escape_once }}" src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

<p><strong>Referentie nummer:</strong> {{ ReferenceNumber|raw }}</p>

<p>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Bekijk de reservering</a> |
    <a href="{{ ScriptUrl|raw }}">Login in {{ AppTitle|raw }}</a>
</p>
