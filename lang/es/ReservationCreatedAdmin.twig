<p><strong>Detalles de la reserva:</strong></p>

<p>
    <strong>Usuario:</strong> {{ UserName|raw }}<br/>
    {% if CreatedBy %}
        <strong>Creado por:</strong>
        {{ CreatedBy|raw }}
        <br/>
    {% endif %}
    <strong>Inicio:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    <strong>Fin:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
    <strong>Título:</strong> {{ Title|escape_once }}<br/>
    <strong>Descripción:</strong> {{ Description|escape_once|nl2br }}
    {% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
    <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}
</p>

<p>

    {% if Resources|default([])|length > 1 %}
    <strong>Recursos ({{ Resources|default([])|length }}):</strong>
    <br/>
    {% else %}
    <strong>Recurso:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>Horario:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>ID del recurso:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Ubicación:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>Contacto:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>Descripción:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Notas:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Administrador del recurso:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Detalles del recurso:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}
</p>

{% if RequiresApproval %}
    <p>* Al menos uno de los recursos reservados requiere aprobación antes de su uso. Asegúrate de que esta solicitud de reserva sea aprobada o rechazada. *</p>
{% endif %}

{% if CheckInEnabled %}
    <p>
    Al menos uno de los recursos reservados requiere que el usuario realice el registro de entrada y salida de la reserva.
        {% if AutoReleaseMinutes is not null %}
            Esta reserva se cancelará a menos que el usuario realice el registro de entrada dentro de los {{ AutoReleaseMinutes|raw }} minutos después de la hora de inicio programada.
        {% endif %}
    </p>
{% endif %}

{% if RepeatRanges|length > 0 %}
    <p>
    La reserva ocurre en las siguientes fechas ({{ RepeatRanges|default([])|length }}):
        <br/>
        {% for date in RepeatRanges %}
            {{ formatdate(date: date.GetBegin()) }}
            {% if not date.IsSameDate() %} - {{ formatdate(date: date.GetEnd()) }}{% endif %}
            <br/>
        {% endfor %}
    </p>
{% endif %}

{% if Participants|default([])|length > 0 %}
    <br/>
    <strong>Participantes ({{ (Participants|default([])|length) + (ParticipatingGuests|default([])|length) }}):</strong>
    <br/>
    {% for user in Participants %}
        {{ user.FullName()|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if ParticipatingGuests|default([])|length > 0 %}
    {% for email in ParticipatingGuests %}
        {{ email|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if Invitees|default([])|length > 0 %}
    <br/>
    <strong>Invitados ({{ (Invitees|default([])|length) + (InvitedGuests|default([])|length) }}):</strong>
    <br/>
    {% for user in Invitees %}
        {{ user.FullName()|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if InvitedGuests|default([])|length > 0 %}
    {% for email in InvitedGuests %}
        {{ email|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if Accessories|default([])|length > 0 %}
    <br/>
    <strong>Accesorios ({{ Accessories|default([])|length }}):</strong>
    <br/>
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}
        <br/>
    {% endfor %}
{% endif %}

<p><strong>Número de referencia:</strong> {{ ReferenceNumber|raw }}</p>

<p>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Ver esta reserva</a> | <a href="{{ ScriptUrl|raw }}">Iniciar sesión en {{ AppTitle|raw }}</a>
</p>
