<p>{{ ParticipantDetails|raw }} a
    {% if (InvitationAction == constant('InvitationAction::Decline') or InvitationAction == constant('InvitationAction::CancelAll') or InvitationAction == constant('InvitationAction::CancelInstance')) %}
        decliné votre invitation à la réservation.
    {% elseif (InvitationAction == constant('InvitationAction::Join') or InvitationAction == constant('InvitationAction::JoinAll')) %}
        rejoint votre réservation.
    {% else %}
        accepté votre invitation à la réservation.
    {% endif %}
</p>
<p><strong>Détails de la réservation:</strong></p>

<p>
    <strong>Début:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    <strong>Fin:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
    <strong>Libellé:</strong> {{ Title|escape_once }}<br/>
    <strong>Description:</strong> {{ Description|escape_once|nl2br }}
    {% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
    <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}
</p>

<p>
    {% if ResourceNames|default([])|length > 1 %}
        <strong>Ressources ({{ ResourceNames|default([])|length }}):</strong>
        <br/>
        {% for resourceName in ResourceNames %}
            {{ resourceName|escape_once }}
            <br/>
        {% endfor %}
    {% else %}
        <strong>Ressource:</strong>
        {{ ResourceName|escape_once }}
        <br/>
    {% endif %}
</p>

{% if ResourceImage %}
    <div class="resource-image"><img alt="{{ ResourceName|escape_once }}" src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

<p><strong>Numéro de la référence:</strong> {{ ReferenceNumber|raw }}</p>

<p>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Voir cette réservation</a> |
    <a href="{{ ScriptUrl|raw }}">Connexion à {{ AppTitle|raw }}</a>
</p>
