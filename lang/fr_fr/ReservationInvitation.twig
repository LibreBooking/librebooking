{% if Deleted %}
    <p>{{ UserName|raw }} a supprimé la réservation</p>
    {% else %}
    <p>{{ UserName|raw }} vous a ajouté à la réservation</p>
{% endif %}

{% if DeleteReason %}
    <p><strong>Raison de l'annulation:</strong>{{ DeleteReason|escape_once|nl2br }}</p>
{% endif %}

<p><strong>Détails de la réservation:</strong></p>

<p>
    <strong>Début:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    <strong>Fin:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
</p>

<p>
{% if ResourceNames|default([])|length > 1 %}
    <strong>Ressources ({{ ResourceNames|default([])|length }}):</strong> <br />
    {% for resourceName in ResourceNames %}
        {{ resourceName|escape_once }}<br/>
    {% endfor %}
{% else %}
    <strong>Ressource:</strong> {{ ResourceName|escape_once }}<br/>
{% endif %}
</p>

{% if ResourceImage %}
    <div class="resource-image"><img alt="{{ ResourceName|escape_once }}" src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

{% if RequiresApproval and not Deleted %}
    <p>* Une ou plusieurs ressources réservées nécessitent une approbation avant leur utilisation. Cette réservation est en attente jusqu'à son approbation. *</p>
{% endif %}

<p>
    <strong>Libellé:</strong> {{ Title|escape_once }}<br/>
    <strong>Description:</strong> {{ Description|escape_once|nl2br }}
</p>

{% if RepeatRanges|length > 0 %}
    <br/>
    <strong>Cette réservation se répète aux dates suivantes ({{ RepeatRanges|default([])|length }}):</strong>
    <br/>
{% endif %}

{% for date in RepeatRanges %}
    {{ formatdate(date: date.GetBegin()) }}
    {% if not date.IsSameDate() %} - {{ formatdate(date: date.GetEnd()) }}{% endif %}
    <br/>
{% endfor %}

{% if Participants|default([])|length > 0 %}
    <br />
    <strong>Participants ({{ (Participants|default([])|length) + (ParticipatingGuests|default([])|length) }}):</strong>
    <br />
    {% for user in Participants %}
        {{ user.FullName()|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if ParticipatingGuests|default([])|length > 0 %}
    {% for email in ParticipatingGuests %}
        {{ email|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if Invitees|default([])|length > 0 %}
    <br />
    <strong>Invités ({{ (Invitees|default([])|length) + (InvitedGuests|default([])|length) }}):</strong>
    <br />
    {% for user in Invitees %}
        {{ user.FullName()|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if InvitedGuests|default([])|length > 0 %}
    {% for email in InvitedGuests %}
        {{ email|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if Accessories|default([])|length > 0 %}
    <br />
       <strong>Accessoires ({{ Accessories|default([])|length }}):</strong>
       <br />
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}
        <br/>
    {% endfor %}
{% endif %}

{% if not Deleted and not Updated %}
<p>
    <strong>Votre présence?</strong> <a href="{{ ScriptUrl|raw }}/{{ AcceptUrl|raw }}">Oui</a> <a href="{{ ScriptUrl|raw }}/{{ DeclineUrl|raw }}">Non</a>
</p>
{% endif %}

{% if not Deleted %}
<a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Voir cette réservation</a> |
<a href="{{ ScriptUrl|raw }}/{{ ICalUrl|raw }}">Ajouter au calendrier</a> |
<a href="{{ GoogleCalendarUrl|raw }}" target="_blank" rel="nofollow">Ajouter au calendrier Google</a> |
{% endif %}
<a href="{{ ScriptUrl|raw }}">Connexion à {{ AppTitle|raw }}</a>
