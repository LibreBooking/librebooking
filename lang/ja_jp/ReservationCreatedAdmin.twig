    Reservation Details:
    <br/>
    <br/>

    ユーザー: {{ UserName|raw }}
    開始: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    終了: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>リソース ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>リソース:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>スケジュール:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>リソースID:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>場所:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>連絡先:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>説明:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>備考:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>リソース管理者:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>リソース詳細:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    件名: {{ Title|escape_once }}<br/>
    説明: {{ Description|escape_once }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        下記の日時で予約されました:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>備品:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        使用に当たって承認が必要なリソースが含まれています。 この予約申請が承認されないこともありますのでご確認ください。
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">予約の表示</a> | <a href="{{ ScriptUrl|raw }}">LibreBooking へログイン</a>
