A foglalás részletei:
<br/>
<br/>

Felhasználó: {{ UserName|raw }}<br/>
{% if CreatedBy %}
    Created by: {{ CreatedBy|raw }}
    <br/>
{% endif %}
Kezdés: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
Befejezés: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
<p>
    {% if Resources|default([])|length > 1 %}
    <strong>Erőforrások ({{ Resources|default([])|length }}):</strong>
    <br/>
    {% else %}
    <strong>Erőforrás:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name|escape_once }}</strong><br/>
        {% if resource.scheduleName %}<strong>Ütemezés:</strong> {{ resource.scheduleName|escape_once }}<br/>{% endif %}
        <strong>Erőforrás azonosító:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Helyszín:</strong> {{ resource.location|escape_once }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kapcsolat:</strong> {{ resource.contact|escape_once }}<br/>{% endif %}
        {% if resource.description %}<strong>Leírás:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Megjegyzések:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Erőforrás rendszergazda:</strong> {{ resource.resourceAdministrator|escape_once }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Erőforrás részletei:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label|escape_once }}</strong></th>
                        <td valign="top">{{ row.displayValue|escape_once|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name|escape_once }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}
</p>

Megnevezés: {{ Title|escape_once }}<br/>
Leírás: {{ Description|escape_once|nl2br }}

{% if RepeatRanges|length > 0 %}
    <br/>
    A foglalás az alábbi dátumokra esik:
    <br/>
{% endif %}

{% for date in RepeatRanges %}
    {{ formatdate(date: date.GetBegin()) }}
    {% if not date.IsSameDate() %} - {{ formatdate(date: date.GetEnd()) }}{% endif %}
    <br/>
{% endfor %}

{% if Participants|default([])|length > 0 %}
    <br/>
    Résztvevők:
    {% for user in Participants %}
        {{ user.FullName()|raw }} <a href="mailto:{{ user.EmailAddress()|raw }}">{{ user.EmailAddress()|raw }}</a>
        <br/>
    {% endfor %}
{% endif %}

{% if ParticipatingGuests|default([])|length > 0 %}
    {% for email in ParticipatingGuests %}
        <a href="mailto:{{ email|raw }}">{{ email|raw }}</a>
        <br/>
    {% endfor %}
{% endif %}

{% if Invitees|default([])|length > 0 %}
    <br/>
    Meghívottak:
    {% for user in Invitees %}
        {{ user.FullName()|raw }} <a href="mailto:{{ user.EmailAddress()|raw }}">{{ user.EmailAddress()|raw }}</a>
        <br/>
    {% endfor %}
{% endif %}

{% if InvitedGuests|default([])|length > 0 %}
    {% for email in InvitedGuests %}
        <a href="mailto:{{ email|raw }}">{{ email|raw }}</a>
        <br/>
    {% endfor %}
{% endif %}

{% if Accessories|default([])|length > 0 %}
    <br/>
    Kiegészítők:
    <br/>
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|escape_once }}
        <br/>
    {% endfor %}
{% endif %}

{% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
        <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}

{% if RequiresApproval %}
    <br/>
    A foglalt elemek legalább egyike jóváhagyást igényel. Kérjük, biztosítsa a foglalás jóváhagyását vagy elvetését.
{% endif %}

{% if CheckInEnabled %}
    <br/>
    A foglalt elemek legalább egyike ki- és bejelentkezést igényel a fogalásba/ból.
    {% if AutoReleaseMinutes is not null %}
        Eza foglalás törlésre kerül, amennyiben nem történik bejelentkezés {{ AutoReleaseMinutes|raw }} perccel az ütemezett kezdést követően.
    {% endif %}
{% endif %}

<br/>
Referenciaszám: {{ ReferenceNumber|raw }}

<br/>
<br/>
<a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Foglalás megtekintése</a> | <a href="{{ ScriptUrl|raw }}">Bejelentkezés ide: {{ AppTitle|raw }}</a>
