includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 3
    errorFormat: prettyJson
    tmpDir: var/cache/phpstan/next
    treatPhpDocTypesAsCertain: false
    paths:
        - Controls
        - Domain
        - Jobs
        - Pages
        - Presenters
        - Web
        - WebServices
        - config
        - lang
        - lib
        - phing-tasks
        # Keep `plugins` in paths so PHPStan can scan symbols used via dynamic plugin loading.
        - plugins
        - src
        - tests
    excludePaths:
        analyse:
            - Web/css/
            - Web/scripts/
            - build/ (?)
            - lib/external/
            # Do not report diagnostics inside `plugins`: The
            # legacy/third-party code is noisy. This keeps analysis focused on
            # core app code while still allowing symbol discovery.
            - plugins/
            - tpl_c/ (?)
            - vendor/
            # Staged "next level" rollout: remove these one-by-one as each
            # area is fixed for the current target level.
            - Pages/Admin/CreditLogPage.php
            - Pages/Admin/ManageAnnouncementsPage.php
            - Pages/Admin/ManageAttributesPage.php
            - Pages/Admin/ManageConfigurationPage.php
            - Pages/Admin/ManageGroupsPage.php
            - Pages/Admin/ManagePaymentsPage.php
            - Pages/Admin/ManageQuotasPage.php
            - Pages/Admin/ManageReservationColorsPage.php
            - Pages/Admin/ManageUsersPage.php
    bootstrapFiles:
        - vendor/autoload.php
