includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 6
    errorFormat: prettyJson
    tmpDir: var/cache/phpstan/next
    treatPhpDocTypesAsCertain: false
    paths:
        - Controls
        - Domain
        - Jobs
        - Pages
        - Presenters
        - Web
        - WebServices
        - config
        - lang
        - lib
        - phing-tasks
        # Keep `plugins` in paths so PHPStan can scan symbols used via dynamic plugin loading.
        - plugins
        - src
        - tests
    excludePaths:
        analyse:
            - Web/css/
            - Web/scripts/
            - build/ (?)
            - lib/external/
            # Do not report diagnostics inside `plugins`: The
            # legacy/third-party code is noisy. This keeps analysis focused on
            # core app code while still allowing symbol discovery.
            - plugins/
            - tpl_c/ (?)
            - vendor/
            # Staged "next level" rollout: remove these one-by-one as each
            # area is fixed for the current target level.
            - Controls/
            - Domain/
            - Jobs/
            - Pages/
            - Presenters/
            - Web/
            - WebServices/
            - config/timezones.php
            - lang/
            - lib/Application/
            - lib/Common/
            - lib/Config/
            - lib/Database/
            - lib/Email/
            - lib/FileSystem/
            - lib/Graphics/
            - lib/Server/
            - lib/WebService/
            - phing-tasks/
            - tests/Application/
            - tests/Common/
            - tests/Domain/
            - tests/Infrastructure/
            - tests/Pages/
            - tests/Plugins/
            - tests/Presenters/
            - tests/TestBase.php
            - tests/WebService/
            - tests/WebServices/
            - tests/data/
            - tests/fakes/
            - tests/lib/
    bootstrapFiles:
        - vendor/autoload.php
    # Corrected PHPDoc for third-party code that cannot be edited.
    stubFiles:
        - tests/phpstan-stubs/FeedWriter.stub
